# Copiar para .env.prod e preencher. NÃO commitar.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
POSTGRES_PASSWORD=trocar-senha-forte-aqui

# ── Sessão / JWT ──────────────────────────────────────────────────────────
# Ver ADR 0020. Modelo: Valkey TTL idle sliding (SESSION_IDLE_HOURS) +
# JWT cap absoluto (SESSION_EXPIRY_DAYS).
# Gerar SESSION_SECRET com: openssl rand -hex 32
SESSION_SECRET=trocar-por-segredo-com-pelo-menos-32-caracteres
SESSION_COOKIE_NAME=mague_session
SESSION_EXPIRY_DAYS=7
SESSION_IDLE_HOURS=3

# ── Email (Resend) ────────────────────────────────────────────────────────
# Free tier: 3000 emails/mês, 100/dia. Domínio (mague.pt) tem de estar
# verificado em https://resend.com/domains (DKIM + SPF na Cloudflare).
#
# EMAIL_PROVIDER controla o adapter:
#   - resend-http (RECOMENDADO em prod): chama directamente POST /emails da
#     Resend; anexos binários como base64 em JSON. Evita o pipeline SMTP/MIME
#     onde o gateway SMTP da Resend corrompia PDFs em violações silenciosas
#     do limite de linha RFC 5321 (1000 octetos).
#   - smtp (default em dev/MailHog): nodemailer + SMTP via SMTP_HOST/PORT.
EMAIL_PROVIDER=resend-http

# API key da Resend (https://resend.com/api-keys). Usada tanto pelo adapter
# `resend-http` (Bearer) como pelo `smtp` (PASS) - partilhamos o secret.
SMTP_PASS=re_xxxxxx
SMTP_FROM="MAGUE <noreply@mague.pt>"

# Só usados quando EMAIL_PROVIDER=smtp. Mantém-se documentado como escape
# hatch (se HTTP API tiver outage, troca para smtp).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465        # ou 587 (STARTTLS)
SMTP_USER=resend     # literal "resend" - Resend exige este username fixo

# ── S3 / Object storage ───────────────────────────────────────────────────
# PDFs de recibos. Opções em prod:
#
# 1) RustFS self-hosted (default no docker-compose.prod.yml - corre em
#    `rustfs:9000` na rede interna). As mesmas creds servem para configurar
#    o admin do rustfs (RUSTFS_ACCESS_KEY/SECRET_KEY) e para o cliente da
#    api (S3_ACCESS_KEY/SECRET_KEY) - ver compose. Bucket tem de existir;
#    cria via console (http://localhost:9001 por SSH tunnel) ou aws-cli.
#      S3_ENDPOINT=http://rustfs:9000
#      S3_REGION=us-east-1
#      S3_BUCKET=mague-receipts
#      S3_FORCE_PATH_STYLE=true
#
# 2) Cloudflare R2 (free tier 10GB):
#      S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#      S3_REGION=auto
#      S3_FORCE_PATH_STYLE=true
#
# 3) AWS S3 (configuração abaixo):
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
S3_BUCKET=mague-receipts-prod
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
S3_FORCE_PATH_STYLE=false

# ── Panel base URL (links em emails) ──────────────────────────────────────
# Origin público do panel - a API valida o header `X-Panel-Base-URL` contra
# este valor antes de o usar para construir URLs em emails (recibos,
# convites, reset password). Sem isto bem configurado, os emails caem no
# default `http://localhost:3400`.
PANEL_BASE_URL=https://painel.mague.pt
# Aliases extra (CSV) - útil para staging + prod a apontar à mesma API.
# PANEL_BASE_URL_EXTRA=https://staging.painel.mague.pt,https://app.mague.pt

# ── CORS ──────────────────────────────────────────────────────────────────
# Domínios autorizados a chamar a API do browser. Se nada aqui, sem CORS.
CORS_ORIGINS=https://painel.mague.pt

# TLS: termina no reverse proxy (ver docker-compose.prod.yml), não nesta stack.
