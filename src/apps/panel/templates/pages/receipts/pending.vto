{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

{{ layout "partials/page_header.vto" {
  title: tab === "skipped"
    ? ("Recibos ignorados · " + String(skipped.length))
    : ("Recibos pendentes · " + String(pending.length)),
  breadcrumbs: [
    { label: "Painel", href: "/admin/c/" + currentCondominiumId + "/dashboard" },
    { label: "Recibos", href: "/admin/c/" + currentCondominiumId + "/receipts" },
    { label: tab === "skipped" ? "Ignoradas" : "Pendentes" },
  ],
  meta: [
    {
      value: tab === "skipped"
        ? "Tuplas (pagamento, fração) marcadas como ignoradas. Retoma para voltarem aos pendentes."
        : "Pagamentos conciliados a aguardar emissão de recibo. Cada linha gera 1 PDF + email aos owners.",
      plain: true,
    },
  ]
} }}
  <a href="/admin/c/{{ currentCondominiumId }}/receipts" class="btn btn-sm btn-ghost">Histórico →</a>
  {{ if tab === "pending" && pending.length > 0 }}
    {{ set _batchSize = pending.length > 100 ? 100 : pending.length }}
    {{ set _batchLabel = pending.length > 100 ? "Emitir lote (" + String(_batchSize) + " de " + String(pending.length) + ")" : "Emitir todos (" + String(pending.length) + ")" }}
    <form method="post" action="/admin/c/{{ currentCondominiumId }}/receipts/emit-bulk"
          data-confirm-title="Emitir recibos em lote"
          data-confirm-body="Vai emitir até {{ String(_batchSize) }} recibos nesta operação{{ if pending.length > 100 }} (de {{ String(pending.length) }} pendentes - repete depois para os restantes){{ /if }}. Cada recibo demora ~500ms (PDF + email aos owners), pelo que isto pode levar até cerca de 1 minuto. Não fechar a janela. Continuar?"
          data-confirm-ok="Emitir lote"
          data-confirm-busy="true"
          data-confirm-busy-message="A emitir recibos…"
          data-confirm-busy-tip="A operação demora cerca de 1 minuto. Não fechar nem recarregar a página.">
      <button type="submit" class="btn btn-sm btn-primary">⚡ {{ _batchLabel }}</button>
    </form>
  {{ /if }}
{{ /layout }}

{{# Tabs no estilo da conciliação - links normais, full GET. #}}
<div role="tablist" class="tabs tabs-bordered mb-4">
  <a href="/admin/c/{{ currentCondominiumId }}/receipts/pending"
     role="tab"
     class="tab {{ if tab === 'pending' }}tab-active{{ /if }}">
    Pendentes
    <span class="ml-1 text-xs text-base-content/50">· {{ String(pending.length) }}</span>
  </a>
  <a href="/admin/c/{{ currentCondominiumId }}/receipts/pending?tab=skipped"
     role="tab"
     class="tab {{ if tab === 'skipped' }}tab-active{{ /if }}">
    Ignoradas
    <span class="ml-1 text-xs text-base-content/50">· {{ String(skipped.length) }}</span>
  </a>
</div>

{{# ─── TAB: PENDENTES ───────────────────────────────────────────────── #}}
{{ if tab === "pending" }}
  {{ if pending.length === 0 }}
    <div class="bg-base-100 rounded-xl border border-base-200 p-12 text-center">
      <div class="text-5xl mb-3 opacity-30">✓</div>
      <p class="text-base-content/60 font-medium">Sem recibos pendentes.</p>
      <p class="text-sm text-base-content/50 mt-1">
        À medida que reconcilias pagamentos, novos recibos aparecem aqui para emissão.
      </p>
      <a href="/admin/c/{{ currentCondominiumId }}/reconciliation" class="btn btn-sm btn-outline mt-4">Ir à conciliação →</a>
    </div>
  {{ else }}
    {{ set _seenUnits = {} }}
    {{ for p of pending }}{{ set _ = _seenUnits[p.unitId] = 1 }}{{ /for }}
    {{ set _totalAmountValue = totalAmount |> formatMoney }}
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 mb-6">
      {{ include "partials/kpi_card.vto" {
        tone: "primary", label: "Pendentes", value: String(pending.length), caption: "tuplas (bank_tx, fração)"
      } }}
      {{ include "partials/kpi_card.vto" {
        tone: "success", label: "Total a emitir", value: _totalAmountValue, caption: "soma dos valores", highlightValue: true
      } }}
      {{ include "partials/kpi_card.vto" {
        tone: "info", label: "Frações distintas", value: String(Object.keys(_seenUnits).length), caption: "a notificar via email", highlightValue: true
      } }}
    </div>

    <div class="bg-base-100 rounded-xl border border-base-200 overflow-hidden shadow-sm" data-table-search-scope>
      <div class="flex justify-between items-center p-4 border-b border-base-200">
        <div class="text-sm font-semibold">Pendentes <span class="text-base-content/50 font-normal">· {{ String(pending.length) }}</span></div>
        <input type="search" data-table-search placeholder="Pesquisar fração…" class="input input-sm input-bordered">
      </div>
      <div class="table-scroll">
        <table class="table table-sm w-full">
          <thead>
            <tr class="text-base-content/40 text-[10px] uppercase tracking-widest border-b border-base-200">
              <th class="pl-4">Data pagamento</th>
              <th>Fração</th>
              <th>Conta</th>
              <th>Descrição banco</th>
              <th class="text-right">Valor</th>
              <th class="text-right pr-4 w-56"></th>
            </tr>
          </thead>
          <tbody>
            {{ for p of pending }}
              <tr id="pending-row-{{ p.bankTransactionId }}-{{ p.unitId }}" class="border-t border-base-100 text-sm hover:bg-base-200/30">
                <td class="pl-4 tabular-nums whitespace-nowrap">{{ p.paymentDate |> formatDate }}</td>
                <td data-search>
                  <a href="/admin/c/{{ currentCondominiumId }}/units/{{ p.unitId }}" class="link link-hover">
                    <span class="font-bold">{{ p.unitDesignation }}</span>{{ if p.unitIdentifier }}<span class="text-base-content/50 font-normal"> - {{ p.unitIdentifier }}</span>{{ /if }}
                  </a>
                </td>
                <td class="text-xs text-base-content/70 whitespace-nowrap">
                  {{ if p.bankAccountKind === "cash" }}💵{{ else }}🏦{{ /if }} {{ p.bankAccountName }}
                </td>
                <td class="text-xs text-base-content/60 max-w-[280px] truncate" title="{{ p.bankTxDescription ?? '' }}">
                  {{ p.bankTxDescription ?? "-" }}
                </td>
                <td class="text-right tabular-nums font-semibold whitespace-nowrap">
                  {{ p.recipientAmount |> formatMoney }}
                </td>
                <td id="pending-action-{{ p.bankTransactionId }}-{{ p.unitId }}" class="pr-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-3">
                    {{# Ignorar: HTMX swap=outerHTML no row → desaparece da
                       lista. Toast OOB confirma. Equivalente ao "ignorar"
                       na conciliação, mas por tupla (bank_tx, fração). #}}
                    <button type="button" class="link text-xs text-base-content/60 hover:text-warning"
                            hx-post="/admin/c/{{ currentCondominiumId }}/receipts/skip"
                            hx-vals='{"bankTransactionId": "{{ p.bankTransactionId }}", "unitId": "{{ p.unitId }}"}'
                            hx-target="#pending-action-{{ p.bankTransactionId }}-{{ p.unitId }}"
                            hx-swap="none"
                            hx-confirm="Ignorar esta linha?

📅 {{ p.paymentDate |> formatDate }}
🏠 {{ p.unitDesignation }}
💶 {{ p.recipientAmount |> formatMoney }}

A linha permanece visível mas marcada como ignorada. Podes retomar a qualquer momento."
                            data-confirm-title="Ignorar pendente"
                            data-confirm-ok="Sim, ignorar"
                            data-confirm-cancel="Cancelar"
                            title="Ignorar - sai da fila, retomável depois">
                      ignorar
                    </button>
                    <button type="button" class="inline-flex items-center gap-1 link link-primary text-xs"
                            data-bank-transaction-id="{{ p.bankTransactionId }}" data-unit-id="{{ p.unitId }}"
                            onclick="openReceiptPreview(this.dataset)"
                            title="Pré-visualizar o recibo antes de emitir">
                      <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      Ver
                    </button>
                    <button type="button" class="btn btn-xs btn-ghost"
                            hx-get="/admin/c/{{ currentCondominiumId }}/receipts/emit-to?bankTransactionId={{ p.bankTransactionId }}&unitId={{ p.unitId }}"
                            hx-target="#receipt_modal_slot"
                            hx-swap="innerHTML show:no"
                            title="Escolher para quem sai o recibo (só essa pessoa recebe)">
                      Emitir para…
                    </button>
                    <button type="button" class="btn btn-xs btn-primary"
                            hx-post="/admin/c/{{ currentCondominiumId }}/receipts/emit"
                            hx-vals='{"bankTransactionId": "{{ p.bankTransactionId }}", "unitId": "{{ p.unitId }}"}'
                            hx-swap="none">
                      Emitir
                    </button>
                  </div>
                </td>
              </tr>
            {{ /for }}
          </tbody>
        </table>
      </div>
    </div>
  {{ /if }}
{{ else }}
  {{# ─── TAB: IGNORADAS ───────────────────────────────────────────── #}}
  {{ if skipped.length === 0 }}
    <div class="bg-base-100 rounded-xl border border-base-200 p-12 text-center">
      <div class="text-5xl mb-3 opacity-30">○</div>
      <p class="text-base-content/60 font-medium">Sem linhas ignoradas.</p>
      <p class="text-sm text-base-content/50 mt-1">
        Linhas que ignores na fila de pendentes aparecem aqui para retomar.
      </p>
    </div>
  {{ else }}
    <div class="bg-base-100 rounded-xl border border-base-200 overflow-hidden shadow-sm" data-table-search-scope>
      <div class="flex justify-between items-center p-4 border-b border-base-200">
        <div class="text-sm font-semibold">Ignoradas <span class="text-base-content/50 font-normal">· {{ String(skipped.length) }}</span></div>
        <input type="search" data-table-search placeholder="Pesquisar fração…" class="input input-sm input-bordered">
      </div>
      <div class="table-scroll">
        <table class="table table-sm w-full">
          <thead>
            <tr class="text-base-content/40 text-[10px] uppercase tracking-widest border-b border-base-200">
              <th class="pl-4">Data pagamento</th>
              <th>Fração</th>
              <th>Conta</th>
              <th>Descrição banco</th>
              <th>Ignorada por</th>
              <th class="text-right">Valor</th>
              <th class="text-right pr-4 w-32"></th>
            </tr>
          </thead>
          <tbody>
            {{ for s of skipped }}
              <tr id="skipped-row-{{ s.bankTransactionId }}-{{ s.unitId }}" class="border-t border-base-100 text-sm hover:bg-base-200/30 opacity-75">
                <td class="pl-4 tabular-nums whitespace-nowrap">{{ s.paymentDate |> formatDate }}</td>
                <td data-search>
                  <a href="/admin/c/{{ currentCondominiumId }}/units/{{ s.unitId }}" class="link link-hover">
                    <span class="font-bold">{{ s.unitDesignation }}</span>{{ if s.unitIdentifier }}<span class="text-base-content/50 font-normal"> - {{ s.unitIdentifier }}</span>{{ /if }}
                  </a>
                </td>
                <td class="text-xs text-base-content/70 whitespace-nowrap">
                  {{ if s.bankAccountKind === "cash" }}💵{{ else }}🏦{{ /if }} {{ s.bankAccountName }}
                </td>
                <td class="text-xs text-base-content/60 max-w-[240px] truncate" title="{{ s.bankTxDescription ?? '' }}">
                  {{ s.bankTxDescription ?? "-" }}
                </td>
                <td class="text-xs text-base-content/60 whitespace-nowrap">
                  {{ s.skippedByName ?? "-" }}
                  {{ if s.reason }}<span class="text-base-content/40 italic"> · {{ s.reason }}</span>{{ /if }}
                </td>
                <td class="text-right tabular-nums font-semibold whitespace-nowrap">
                  {{ s.recipientAmount |> formatMoney }}
                </td>
                <td class="pr-4 text-right whitespace-nowrap">
                  <button type="button" class="link link-primary text-xs"
                          hx-post="/admin/c/{{ currentCondominiumId }}/receipts/unskip"
                          hx-vals='{"bankTransactionId": "{{ s.bankTransactionId }}", "unitId": "{{ s.unitId }}"}'
                          hx-target="#skipped-row-{{ s.bankTransactionId }}-{{ s.unitId }}"
                          hx-swap="outerHTML swap:200ms"
                          title="Retomar - volta à fila de pendentes">
                    retomar
                  </button>
                </td>
              </tr>
            {{ /for }}
          </tbody>
        </table>
      </div>
    </div>
  {{ /if }}
{{ /if }}

{{# Slot do modal "Emitir para…" (hx-get); o emit esvazia-o via OOB para fechar o modal. #}}
<div id="receipt_modal_slot"></div>

{{# Pré-visualização do recibo (dialog + iframe sandbox, padrão da convocatória). Aberta pela
   linha ("Ver", regra por defeito) ou pelo "Emitir para…" (com o destinatário escolhido). #}}
<dialog id="receipt_preview_modal" class="modal">
  <div class="modal-box max-w-4xl">
    <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
    <h3 class="font-bold text-base pr-8">Pré-visualização do recibo</h3>
    <p class="text-xs text-base-content/60 mt-1">Tal como sairia no PDF. O número só é atribuído na emissão.</p>
    <div class="mt-4 border border-base-200 rounded-lg overflow-hidden bg-base-200/40">
      <iframe id="receipt_preview_iframe" sandbox class="w-full h-[75vh] bg-white" title="Pré-visualização do recibo"></iframe>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>fechar</button></form>
</dialog>

<script>
  // params = { bankTransactionId, unitId } (linha) ou form do "Emitir para…" (com destinatário).
  window.openReceiptPreview = async function (params, form) {
    if (form && !form.reportValidity()) return;
    const body = new URLSearchParams(form ? new FormData(form) : Object.assign({}, params));
    const modal = document.getElementById("receipt_preview_modal");
    const iframe = document.getElementById("receipt_preview_iframe");
    iframe.srcdoc =
      '<!doctype html><meta charset="utf-8"><body style="font-family:system-ui,sans-serif;padding:2rem;color:#6b7280;">A gerar pré-visualização...</body>';
    modal.showModal();
    try {
      const resp = await fetch("/admin/c/{{ currentCondominiumId }}/receipts/preview", {
        method: "POST",
        body,
        headers: { Accept: "application/json" },
      });
      const data = await resp.json();
      iframe.srcdoc = data.html;
    } catch (_e) {
      iframe.srcdoc =
        '<!doctype html><meta charset="utf-8"><body style="font-family:system-ui,sans-serif;padding:2rem;color:#b91c1c;">Erro a gerar a pré-visualização.</body>';
    }
  };
</script>

{{# Toasts (auto-dismiss + progresso) vivem no admin.vto; sem JS local. #}}

{{ /layout }}
