{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

<div class="max-w-2xl">
  {{ include "partials/page_header.vto" {
    title: "Nova conta bancária",
    scale: "detail",
    breadcrumbs: [
      { label: "Contas bancárias", href: "/admin/c/" + currentCondominiumId + "/bank-accounts" },
      { label: "Nova" },
    ]
  } }}

  <form method="post" action="/admin/c/{{ currentCondominiumId }}/bank-accounts" class="card bg-base-100 shadow-sm border border-base-200 p-6 space-y-4">
    <div class="form-control">
      <label class="label"><span class="label-text font-medium">Tipo de conta</span></label>
      <div class="grid grid-cols-2 gap-2">
        <label class="cursor-pointer border border-base-300 rounded-lg p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5 hover:bg-base-200/50">
          <div class="flex items-center gap-2">
            <input type="radio" name="kind" value="bank" class="radio radio-sm radio-primary" checked onchange="onKindChange('bank')">
            <span class="font-medium text-sm">🏦 Banco</span>
          </div>
          <div class="text-xs text-base-content/60 mt-1 ml-6">Conta real, alimentada por importação de CSV.</div>
        </label>
        <label class="cursor-pointer border border-base-300 rounded-lg p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5 hover:bg-base-200/50">
          <div class="flex items-center gap-2">
            <input type="radio" name="kind" value="cash" class="radio radio-sm radio-primary" onchange="onKindChange('cash')">
            <span class="font-medium text-sm">💵 Caixa (numerário)</span>
          </div>
          <div class="text-xs text-base-content/60 mt-1 ml-6">Recebimentos em dinheiro inseridos à mão.</div>
        </label>
      </div>
    </div>
    <div class="form-control">
      <label class="label" for="bankName"><span class="label-text font-medium" id="bankNameLabel">Banco</span></label>
      <input type="text" id="bankName" name="bankName" class="input input-bordered" required maxlength="100" placeholder="Ex: Millennium BCP">
    </div>
    <div class="form-control">
      <label class="label" for="accountName"><span class="label-text font-medium">Nome da conta</span></label>
      <input type="text" id="accountName" name="accountName" class="input input-bordered" maxlength="255" placeholder="Conta principal">
    </div>
    <div class="form-control" id="ibanField">
      <label class="label" for="iban"><span class="label-text font-medium">IBAN</span></label>
      <input type="text" id="iban" name="iban" class="input input-bordered font-mono" maxlength="34" placeholder="PT50...">
    </div>
    <div class="form-control" id="accountHolderField">
      <label class="label" for="accountHolder"><span class="label-text font-medium">Titular da conta</span></label>
      <input type="text" id="accountHolder" name="accountHolder" class="input input-bordered" maxlength="255" placeholder="Ex: Condomínio Av da Mague, X">
      <span class="text-xs text-base-content/50 mt-1">Nome que aparece no portal do condómino quando faz transferência.</span>
    </div>
    <div class="form-control" id="quotaPaymentField">
      <label class="label cursor-pointer justify-start gap-3">
        <input type="checkbox" name="isQuotaPayment" value="true" class="checkbox checkbox-primary">
        <span class="label-text">Conta divulgada para pagamentos</span>
      </label>
      <span class="text-xs text-base-content/50 mt-1 ml-9">Aparece no portal do condómino com IBAN + titular para transferência (quotas, refaturações ou outros pagamentos). Pode ter mais de uma marcada.</span>
    </div>
    <p class="text-xs text-base-content/60 -mt-1">
      O saldo de abertura (ordinário + FCR) é definido na página de edição depois de criares a conta.
    </p>
    <div class="flex justify-end gap-2 pt-4">
      <a href="/admin/c/{{ currentCondominiumId }}/bank-accounts" class="btn btn-sm btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-sm btn-primary">Criar conta</button>
    </div>
  </form>
</div>

<script>
  // Mostra/esconde IBAN e ajusta label/placeholder consoante o tipo (polish; server valida).
  window.onKindChange = function (kind) {
    var ibanField = document.getElementById("ibanField");
    var holderField = document.getElementById("accountHolderField");
    var quotaField = document.getElementById("quotaPaymentField");
    var bankNameLabel = document.getElementById("bankNameLabel");
    var bankNameInput = document.getElementById("bankName");
    if (kind === "cash") {
      ibanField.classList.add("hidden");
      holderField.classList.add("hidden");
      quotaField.classList.add("hidden");
      var qcb = quotaField.querySelector("input[name='isQuotaPayment']");
      if (qcb) qcb.checked = false;
      bankNameLabel.textContent = "Designação";
      bankNameInput.placeholder = "Ex: Caixa principal";
    } else {
      ibanField.classList.remove("hidden");
      holderField.classList.remove("hidden");
      quotaField.classList.remove("hidden");
      bankNameLabel.textContent = "Banco";
      bankNameInput.placeholder = "Ex: Millennium BCP";
    }
  };
</script>

{{ /layout }}
