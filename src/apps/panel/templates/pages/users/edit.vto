{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

{{ set isSelf = currentUser && currentUser.id === target.id }}

<div class="max-w-2xl">
  {{ include "partials/page_header.vto" {
    title: "Editar utilizador",
    scale: "detail",
    breadcrumbs: [
      { label: "Utilizadores", href: "/admin/c/" + currentCondominiumId + "/users" },
      { label: target.name, href: "/admin/c/" + currentCondominiumId + "/users/" + target.id },
      { label: "Editar" },
    ],
  } }}
  <form id="user-edit-form" method="post" action="/admin/c/{{ currentCondominiumId }}/users/{{ target.id }}/update" class="card bg-base-100 shadow-sm border border-base-200 p-6 space-y-4">
    {{# Aqui só identidade de auth. nif/phone vivem em
        core.occupant (edita em /admin/c/:cid/occupants/:id). #}}
    <div class="form-control">
      <label class="label" for="name"><span class="label-text font-medium">Nome</span></label>
      {{# Mesma regra do reset: a conta abre outro condomínio (ou é super). Disabled não é submetido. #}}
      <input type="text" id="name" name="name" class="input input-bordered" maxlength="255" value="{{ target.name ?? '' }}"{{ if target.passwordResetRequiresSuper }} disabled{{ /if }}>
      {{ if target.passwordResetRequiresSuper }}
      <label class="label"><span class="label-text-alt text-base-content/50">Esta conta também dá acesso a outro condomínio: só um super pode alterar o nome.</span></label>
      {{ else }}
      <label class="label"><span class="label-text-alt text-base-content/50">Display fallback. Para owners com fração, o nome do occupant é preferido.</span></label>
      {{ /if }}
    </div>

    <div class="form-control">
      <label class="label" for="email"><span class="label-text font-medium">Email</span></label>
      <input type="email" id="email" class="input input-bordered" value="{{ target.email ?? '' }}" disabled>
      <label class="label"><span class="label-text-alt text-base-content/50">Email não editável - usado para autenticação.</span></label>
    </div>

    {{# Toggle de admin (ADR 0002). Hidden `isManagerSubmitted` é o sentinel
       (HTML não envia checkbox unchecked). Backend dá 409 LAST_MANAGER se
       for o último admin ativo. #}}
    <div class="form-control border-t border-base-200 pt-4">
      <label class="label cursor-pointer justify-start gap-3">
        <input type="hidden" name="isManagerSubmitted" value="1">
        <input type="checkbox" id="isManager" name="isManager" value="true" class="toggle toggle-primary"
               {{ if target.isManager }}checked{{ /if }}>
        <span class="label-text font-medium">É administrador deste condomínio</span>
      </label>
      <label class="label">
        <span class="label-text-alt text-base-content/50">
          {{ if isSelf }}Cuidado: és tu mesmo. Desmarcar perde o teu acesso de administrador.
          {{ else }}Concede acesso de gestão. Apenas administradores existentes podem alterar.
          {{ /if }}
        </span>
      </label>
    </div>

    <div class="flex justify-end gap-2 pt-4 border-t border-base-200">
      <a href="/admin/c/{{ currentCondominiumId }}/users/{{ target.id }}" class="btn btn-sm btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-sm btn-primary">Guardar alterações</button>
    </div>
  </form>
</div>

{{# Self-removal guard: confirma antes de o user desmarcar o próprio toggle
   de admin. Não usa `data-confirm-*` porque a confirmação é condicional. #}}
{{ if isSelf }}
<script>
  (function () {
    var form = document.getElementById("user-edit-form");
    var checkbox = document.getElementById("isManager");
    if (!form || !checkbox) return;
    var wasChecked = {{ target.isManager ? "true" : "false" }};
    form.addEventListener("submit", function (e) {
      if (form.dataset.__confirmed === "true") {
        delete form.dataset.__confirmed;
        return;
      }
      if (wasChecked && !checkbox.checked) {
        e.preventDefault();
        e.stopImmediatePropagation();
        window.confirmAction({
          title: "Remover-te como administrador?",
          body: "Vais perder o teu acesso de administrador a este condomínio. Só outro administrador ou super pode reverter.",
          danger: true,
          okText: "Confirmar",
        }).then(function (ok) {
          if (!ok) return;
          form.dataset.__confirmed = "true";
          if (typeof form.requestSubmit === "function") form.requestSubmit();
          else form.submit();
        });
      }
    }, true);
  })();
</script>
{{ /if }}

{{ /layout }}
