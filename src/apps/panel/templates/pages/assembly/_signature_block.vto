{{# Partial do card "Ata (assinatura legal)" + modal. POST /sign-minutes
   (HX-Request) faz outerHTML swap de `#signature-card` E OOB swap do
   `<dialog>` para os values pré-computados acompanharem o estado da BD. #}}

{{ set signedPres = target.presidentOccupantId ? occupants.find((x) => x.id === target.presidentOccupantId) : null }}
{{ set signedSec = target.secretaryOccupantId ? occupants.find((x) => x.id === target.secretaryOccupantId) : null }}
{{ set signedPresLabel = signedPres ? signedPres.name : "" }}
{{ set signedSecLabel = signedSec ? signedSec.name : "" }}
{{# YYYY-MM-DD: input type="date" não aceita timestamp com hora. #}}
{{ set signedAtLocal = target.minutesSignedAt ? target.minutesSignedAt.slice(0, 10) : "" }}

<div id="signature-card" class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden mb-6">
  <div class="px-6 pt-5 pb-3 border-b border-base-200 flex items-center justify-between">
    <h2 class="text-lg font-bold">Ata (assinatura legal)</h2>
    {{ if canEdit }}
      <button type="button" class="btn btn-xs {{ if target.minutesSignedAt }}btn-ghost{{ else }}btn-primary{{ /if }}" onclick="document.getElementById('modal_sign_minutes').showModal()">
        {{ if target.minutesSignedAt }}Editar assinatura{{ else }}Assinar ata{{ /if }}
      </button>
    {{ /if }}
  </div>
  <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
    <div>
      <div class="text-xs text-base-content/50 uppercase tracking-wider mb-1">Presidente</div>
      <div class="font-medium">{{ signedPres ? signedPres.name : "-" }}</div>
    </div>
    <div>
      <div class="text-xs text-base-content/50 uppercase tracking-wider mb-1">Secretário</div>
      <div class="font-medium">{{ signedSec ? signedSec.name : "-" }}</div>
    </div>
    <div>
      <div class="text-xs text-base-content/50 uppercase tracking-wider mb-1">Assinada em</div>
      <div class="font-medium tabular-nums">{{ if target.minutesSignedAt }}{{ target.minutesSignedAt |> formatDate }}{{ else }}<span class="text-base-content/40">Por assinar</span>{{ /if }}</div>
    </div>
  </div>
</div>

{{# `hx-swap-oob` substitui o modal na DOM com os values novos pré-preenchidos
   (combobox + data carregados com o estado atual). #}}
{{ if canEdit }}
  <dialog id="modal_sign_minutes" class="modal" hx-swap-oob="outerHTML">
    <div class="modal-box max-w-md overflow-visible">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-lg mb-2">{{ if target.minutesSignedAt }}Editar assinatura da ata{{ else }}Assinar ata{{ /if }}</h3>
      <p class="text-xs text-base-content/60 mb-4">
        Regista (ou corrige) quem assinou a ata (Art. 1434.º) e a data da assinatura. Os 3 campos vão juntos - é regra legal: assinatura tem sempre data, e ambos os signatários.
      </p>
      <form method="post"
            action="/admin/c/{{ currentCondominiumId }}/assembly/{{ target.id }}/sign-minutes"
            hx-post="/admin/c/{{ currentCondominiumId }}/assembly/{{ target.id }}/sign-minutes"
            hx-target="#signature-card"
            hx-swap="outerHTML"
            id="sign_minutes_form"
            class="space-y-3">
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Presidente *</span></label>
          <div class="relative" data-combobox>
            <input type="text" data-combobox-search autocomplete="off"
                   placeholder="Pesquisar por nome, email ou NIF…"
                   value="{{ signedPresLabel }}"
                   class="input input-sm input-bordered" required>
            <input type="hidden" name="presidentOccupantId" data-combobox-value value="{{ target.presidentOccupantId ?? '' }}" required>
            <ul data-combobox-list class="hidden absolute top-full left-0 right-0 z-30 mt-1 max-h-60 overflow-y-auto bg-base-100 border border-base-200 rounded-lg shadow-lg py-1">
              {{ for o of occupants }}
                <li data-combobox-option
                    data-id="{{ o.id }}"
                    data-label="{{ o.name }}"
                    data-haystack="{{ ((o.name ?? '') + ' ' + (o.email ?? '') + ' ' + (o.nif ?? '')).toLowerCase() }}"
                    class="px-3 py-1.5 text-sm hover:bg-base-200 cursor-pointer">
                  <span class="font-medium">{{ o.name }}</span>{{ if o.email }}<span class="text-base-content/50 text-xs"> · {{ o.email }}</span>{{ /if }}
                </li>
              {{ /for }}
              <li data-combobox-empty class="hidden px-3 py-2 text-sm text-base-content/50 italic">Sem resultados.</li>
            </ul>
          </div>
        </div>
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Secretário *</span></label>
          <div class="relative" data-combobox>
            <input type="text" data-combobox-search autocomplete="off"
                   placeholder="Pesquisar por nome, email ou NIF…"
                   value="{{ signedSecLabel }}"
                   class="input input-sm input-bordered" required>
            <input type="hidden" name="secretaryOccupantId" data-combobox-value value="{{ target.secretaryOccupantId ?? '' }}" required>
            <ul data-combobox-list class="hidden absolute top-full left-0 right-0 z-30 mt-1 max-h-60 overflow-y-auto bg-base-100 border border-base-200 rounded-lg shadow-lg py-1">
              {{ for o of occupants }}
                <li data-combobox-option
                    data-id="{{ o.id }}"
                    data-label="{{ o.name }}"
                    data-haystack="{{ ((o.name ?? '') + ' ' + (o.email ?? '') + ' ' + (o.nif ?? '')).toLowerCase() }}"
                    class="px-3 py-1.5 text-sm hover:bg-base-200 cursor-pointer">
                  <span class="font-medium">{{ o.name }}</span>{{ if o.email }}<span class="text-base-content/50 text-xs"> · {{ o.email }}</span>{{ /if }}
                </li>
              {{ /for }}
              <li data-combobox-empty class="hidden px-3 py-2 text-sm text-base-content/50 italic">Sem resultados.</li>
            </ul>
          </div>
        </div>
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Data da assinatura *</span></label>
          <input type="date" name="minutesSignedAt"
                 value="{{ signedAtLocal }}"
                 class="input input-sm input-bordered" required>
        </div>
        <div class="flex justify-end gap-2 pt-3 border-t border-base-200">
          <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('modal_sign_minutes').close()">Cancelar</button>
          <button type="submit" class="btn btn-sm btn-primary">{{ if target.minutesSignedAt }}Guardar alterações{{ else }}Assinar agora{{ /if }}</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
{{ /if }}

{{# Toast OOB para #toast-container (auto-dismiss via JS global, admin.vto). #}}
{{ if toast }}
  <div id="toast-container" hx-swap-oob="beforeend">
    <div class="rounded-lg bg-base-100 shadow-lg min-w-[260px]" data-auto-dismiss="4000">
      <div class="relative overflow-hidden rounded-lg bg-success/10 border border-success/30 pl-4 pr-8 py-3 flex items-start gap-3">
        <span class="text-success text-lg leading-none">✓</span>
        <span class="text-sm font-medium text-base-content">{{ toast.message }}</span>
        <button type="button"
                class="absolute right-2 top-2 text-success opacity-50 hover:opacity-100 text-sm leading-none"
                aria-label="Fechar"
                data-toast-close>✕</button>
        <div class="absolute bottom-0 left-0 h-0.5 bg-success opacity-60"
             style="width: 0%" data-toast-progress></div>
      </div>
    </div>
  </div>
{{ /if }}
