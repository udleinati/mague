{{ layout "layouts/portal.vto" { title, section, condominium, unit, currentUser, currentPortalUnitId, currentCondominiumId } }}

<div class="mb-4">
  <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/assemblies" class="text-xs text-base-content/60 hover:text-base-content">← Assembleias</a>
</div>

{{# ─── Cabeçalho ─────────────────────────────────────────────────────── #}}
<div class="bg-base-100 rounded-xl border border-base-200 shadow-sm p-4 sm:p-6 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 mb-4">
    <div class="min-w-0 flex-1">
      <div class="text-xs uppercase tracking-wider text-base-content/50 mb-1">Orçamento</div>
      <h1 class="text-xl sm:text-2xl font-bold flex items-center gap-2 flex-wrap">
        {{ budget.year }}
        {{ if budget.type === "suplementar" }}
          <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 border border-indigo-200">Suplementar</span>
        {{ /if }}
      </h1>
      <div class="text-xs sm:text-sm text-base-content/60 mt-1 flex flex-wrap gap-x-1.5 gap-y-0.5">
        <span>FCR {{ budget.fcrPercentage }}%</span>
        {{ if budget.approvedAt }}<span class="text-base-content/30">·</span><span>Aprovado em {{ budget.approvedAt |> formatDate }}</span>{{ /if }}
        {{ if budget.quotasGeneratedAt }}
          <span class="text-base-content/30">·</span>
          <span class="text-success/80 inline-flex items-center gap-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>Quotas geradas
          </span>
        {{ /if }}
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-success shrink-0">
      <span class="inline-block w-2 h-2 rounded-full bg-success"></span>Aprovado
    </span>
  </div>

  {{# 3 KPIs do orçamento - espelhar a vista admin (ordinária / FCR / total). #}}
  <div class="grid grid-cols-3 gap-2 sm:gap-3 pt-4 border-t border-base-200">
    <div class="min-w-0">
      <div class="text-[10px] uppercase tracking-wider text-base-content/50">Despesas ordinárias</div>
      <div class="text-base sm:text-lg font-bold tabular-nums mt-1 break-words">{{ budget.totalAmount |> formatMoney }}</div>
    </div>
    <div class="min-w-0">
      <div class="text-[10px] uppercase tracking-wider text-base-content/50">FCR ({{ budget.fcrPercentage }}%)</div>
      <div class="text-base sm:text-lg font-bold tabular-nums mt-1 break-words text-base-content/70">{{ budget.fcrAmount |> formatMoney }}</div>
    </div>
    <div class="min-w-0">
      <div class="text-[10px] uppercase tracking-wider text-base-content/50">Total anual</div>
      <div class="text-base sm:text-lg font-bold tabular-nums mt-1 break-words text-primary">{{ grandTotal |> formatMoney }}</div>
    </div>
  </div>

  {{ if budget.notes }}
    <div class="mt-4 pt-4 border-t border-base-200 text-xs text-base-content/70 leading-relaxed whitespace-pre-line">
      {{ budget.notes }}
    </div>
  {{ /if }}
</div>

{{# ─── A minha quota ────────────────────────────────────────────────────
   Quota desta fração (mensal + anual). Sem `myQuota` (fração sem permilagem
   ou orçamento sem linhas), o bloco não aparece. #}}
{{ if myQuota }}
  <section class="bg-gradient-to-br from-primary/10 to-primary/5 rounded-xl border border-primary/20 p-4 sm:p-6 mb-6">
    <div class="flex items-baseline justify-between gap-3 flex-wrap mb-3">
      <h2 class="text-sm font-bold text-primary/80 uppercase tracking-wider">A minha quota</h2>
      <div class="text-xs text-base-content/60">
        {{ myQuota.unitDesignation }}{{ if unit.identifier }} · {{ unit.identifier }}{{ /if }} · {{ myQuota.unitPermillage |> formatPermillage }}‰
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <div class="bg-base-100 rounded-lg p-3 sm:p-4">
        <div class="text-[10px] uppercase tracking-wider text-base-content/50">Mensal</div>
        <div class="text-xl sm:text-2xl xl:text-3xl font-black tabular-nums mt-1 text-primary whitespace-nowrap">{{ myQuota.monthlyTotalCents |> formatMoney }}</div>
        <div class="text-[10px] text-base-content/50 mt-0.5">
          base {{ myQuota.monthlyBaseCents |> formatMoney }} + FCR {{ myQuota.monthlyFcrCents |> formatMoney }}
        </div>
      </div>
      <div class="bg-base-100 rounded-lg p-3 sm:p-4">
        <div class="text-[10px] uppercase tracking-wider text-base-content/50">Anual</div>
        <div class="text-xl sm:text-2xl xl:text-3xl font-black tabular-nums mt-1 text-primary whitespace-nowrap">{{ myQuota.annualTotalCents |> formatMoney }}</div>
        <div class="text-[10px] text-base-content/50 mt-0.5">12 meses</div>
      </div>
    </div>
  </section>
{{ /if }}

{{# ─── Rubricas (categorias de despesa) ──────────────────────────────────
   Ordenado por valor desc. Mobile: cards; desktop: tabela. #}}
<section class="bg-base-100 rounded-xl border border-base-200 shadow-sm overflow-hidden">
  <div class="px-4 sm:px-5 py-3 border-b border-base-200 flex items-baseline justify-between gap-3">
    <h2 class="text-sm font-bold">Rubricas previstas</h2>
    <div class="text-xs text-base-content/50">{{ String(lines.length) }} {{ lines.length === 1 ? "rubrica" : "rubricas" }}</div>
  </div>

  {{ if lines.length === 0 }}
    <div class="p-8 text-center text-sm text-base-content/50">
      Sem rubricas registadas neste orçamento.
    </div>
  {{ else }}
    {{# Mobile: cards #}}
    <div class="md:hidden divide-y divide-base-200">
      {{ for line of lines }}
        <div class="px-4 py-3 flex items-baseline justify-between gap-3">
          <div class="text-sm font-medium min-w-0 flex-1 break-words">{{ line.categoryName ?? "-" }}</div>
          <div class="text-sm font-semibold tabular-nums whitespace-nowrap shrink-0">{{ line.annualAmount |> formatMoney }}</div>
        </div>
      {{ /for }}
      <div class="px-4 py-3 flex items-baseline justify-between gap-3 bg-base-200/40">
        <div class="text-sm font-bold">Total ordinárias</div>
        <div class="text-sm font-bold tabular-nums">{{ budget.totalAmount |> formatMoney }}</div>
      </div>
      <div class="px-4 py-3 flex items-baseline justify-between gap-3">
        <div class="text-sm">FCR ({{ budget.fcrPercentage }}%)</div>
        <div class="text-sm tabular-nums text-base-content/70">{{ budget.fcrAmount |> formatMoney }}</div>
      </div>
      <div class="px-4 py-3 flex items-baseline justify-between gap-3 bg-primary/5">
        <div class="text-sm font-bold">Total anual</div>
        <div class="text-base font-black tabular-nums text-primary">{{ grandTotal |> formatMoney }}</div>
      </div>
    </div>

    {{# Desktop: tabela #}}
    <div class="hidden md:block overflow-x-auto">
      <table class="table table-sm w-full">
        <thead>
          <tr class="text-base-content/40 text-[10px] uppercase tracking-widest">
            <th class="pl-5">Rubrica</th>
            <th class="text-right pr-5">Anual</th>
          </tr>
        </thead>
        <tbody>
          {{ for line of lines }}
            <tr class="border-t border-base-100 text-sm">
              <td class="py-2 pl-5">{{ line.categoryName ?? "-" }}</td>
              <td class="py-2 pr-5 text-right tabular-nums">{{ line.annualAmount |> formatMoney }}</td>
            </tr>
          {{ /for }}
        </tbody>
        <tfoot>
          <tr class="font-bold border-t border-base-200">
            <td class="py-3 pl-5">Total ordinárias</td>
            <td class="py-3 pr-5 text-right tabular-nums">{{ budget.totalAmount |> formatMoney }}</td>
          </tr>
          <tr class="bg-base-200/50">
            <td class="py-3 pl-5">FCR ({{ budget.fcrPercentage }}%)</td>
            <td class="py-3 pr-5 text-right tabular-nums text-base-content/70">{{ budget.fcrAmount |> formatMoney }}</td>
          </tr>
          <tr class="font-bold bg-primary/5">
            <td class="py-3 pl-5">Total anual</td>
            <td class="py-3 pr-5 text-right tabular-nums text-primary">{{ grandTotal |> formatMoney }}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  {{ /if }}
</section>

{{# Hint pedagógico - explica o ciclo do orçamento ao condómino. #}}
<div class="mt-6 bg-info/5 border border-info/20 rounded-lg px-4 py-3 text-xs text-base-content/70 leading-relaxed">
  As quotas mensais são geradas automaticamente a partir deste orçamento e aparecem na tua lista de
  <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/charges" class="text-primary hover:underline">cobranças</a>.
  O FCR (Fundo Comum de Reserva) é uma poupança obrigatória do condomínio (DL 268/94) e fica reservado para obras futuras.
</div>

{{ /layout }}
