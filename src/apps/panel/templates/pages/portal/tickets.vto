{{ layout "layouts/portal.vto" { title, section, condominium, unit, currentUser, currentPortalUnitId, currentCondominiumId } }}

{{# Cores da pill de estado, espelhadas de ticket_show.vto e do admin. #}}
{{ set statusBadge = {
  open: { classes: "bg-amber-100", style: "color:#854D0E", dot: "background:#854D0E" },
  in_progress: { classes: "bg-info/10 text-info", style: "", dot: "" },
  resolved: { classes: "bg-success/10 text-success", style: "", dot: "" },
  closed: { classes: "bg-purple-100", style: "color:#6B21A8", dot: "background:#6B21A8" }
} }}

{{# ─── Cabeçalho ─────────────────────────────────────────────────────── #}}
<div class="flex flex-wrap items-start justify-between gap-3 mb-6">
  <div>
    <h1 class="text-2xl sm:text-3xl font-black">Ocorrências</h1>
    <p class="text-sm text-base-content/60 mt-1 max-w-xl">
      Reporta problemas ou pedidos relativos à fração ou áreas comuns. O administrador acompanha e responde.
    </p>
  </div>
  <button type="button" class="btn btn-sm btn-primary"
          onclick="document.getElementById('modal_new_ticket').showModal()">
    Nova ocorrência
  </button>
</div>

{{# ─── Tabs por estado (server-side via `?status=`) ──────────────────────
   Cada tab só aparece quando tem tickets - evita tabs vazias. #}}
{{ if statusCounts.all > 0 }}
  <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
    <div class="tabs tabs-boxed bg-base-200/50 p-1">
      <a href="?" class="tab tab-sm {{ if !filterStatus }}tab-active{{ /if }}">
        Todas <span class="ml-1 opacity-70">({{ String(statusCounts.all) }})</span>
      </a>
      {{ if statusCounts.open > 0 }}
        <a href="?status=open" class="tab tab-sm {{ if filterStatus === 'open' }}tab-active{{ /if }}">
          Abertas <span class="ml-1 opacity-70">({{ String(statusCounts.open) }})</span>
        </a>
      {{ /if }}
      {{ if statusCounts.in_progress > 0 }}
        <a href="?status=in_progress" class="tab tab-sm {{ if filterStatus === 'in_progress' }}tab-active{{ /if }}">
          Em curso <span class="ml-1 opacity-70">({{ String(statusCounts.in_progress) }})</span>
        </a>
      {{ /if }}
      {{ if statusCounts.resolved > 0 }}
        <a href="?status=resolved" class="tab tab-sm {{ if filterStatus === 'resolved' }}tab-active{{ /if }}">
          Resolvidas <span class="ml-1 opacity-70">({{ String(statusCounts.resolved) }})</span>
        </a>
      {{ /if }}
      {{ if statusCounts.closed > 0 }}
        <a href="?status=closed" class="tab tab-sm {{ if filterStatus === 'closed' }}tab-active{{ /if }}">
          Fechadas <span class="ml-1 opacity-70">({{ String(statusCounts.closed) }})</span>
        </a>
      {{ /if }}
    </div>
    <div class="text-xs text-base-content/60">
      <strong class="text-base-content/90">{{ String(tickets.length) }}</strong> {{ tickets.length === 1 ? "ocorrência" : "ocorrências" }}
    </div>
  </div>
{{ /if }}

{{# ─── Lista ─────────────────────────────────────────────────────────── #}}
{{ if tickets.length === 0 }}
  <div class="bg-base-100 rounded-xl border border-base-200 p-12 text-center">
    <div class="text-5xl mb-3 opacity-30">📋</div>
    <p class="text-base-content/60 font-medium">
      {{ if filterStatus }}Sem ocorrências neste estado.{{ else }}Sem ocorrências registadas.{{ /if }}
    </p>
    <p class="text-sm text-base-content/50 mt-1">
      {{ if filterStatus }}
        <a href="?" class="link link-primary">Ver todas</a> ou usa o botão acima para reportar uma nova.
      {{ else }}
        Usa o botão acima para reportar um problema.
      {{ /if }}
    </p>
  </div>
{{ else }}
  <div class="bg-base-100 rounded-xl border border-base-200 shadow-sm divide-y divide-base-200 overflow-hidden">
    {{ for t of tickets }}
      {{ set ticketUrl = "/portal/c/" + currentCondominiumId + "/u/" + currentPortalUnitId + "/tickets/" + t.id }}
      {{ set badge = statusBadge[t.status] ?? statusBadge.open }}
      <a href="{{ ticketUrl }}" class="block hover:bg-base-200/30 transition-colors px-4 py-3">
        <div class="flex items-start gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2 flex-wrap">
              <span class="font-mono text-xs text-base-content/40">{{ t.code }}</span>
              <span class="font-semibold text-sm break-words">{{ t.title }}</span>
            </div>
            <div class="text-xs text-base-content/50 mt-1 flex items-center gap-1.5 flex-wrap">
              <span>{{ categoryLabels[t.category] ?? t.category }}</span>
              {{# "Zona comum": pública sem fração, vem da administração. #}}
              {{ if t.visibility === "public" && !t.unitId }}
                <span class="text-base-content/30">·</span>
                <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded bg-success/10 text-success">
                  <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                  Zona comum
                </span>
              {{ /if }}
              {{ if t.priority && t.priority !== "normal" }}
                <span class="text-base-content/30">·</span>
                <span class="font-medium {{ if t.priority === 'urgent' }}text-error{{ else if t.priority === 'high' }}text-amber-700{{ /if }}">{{ priorityLabels[t.priority] ?? t.priority }}</span>
              {{ /if }}
              {{ if t.location }}
                <span class="text-base-content/30">·</span>
                <span class="truncate max-w-[180px]">{{ t.location }}</span>
              {{ /if }}
              <span class="text-base-content/30">·</span>
              <span class="tabular-nums">{{ t.createdAt |> formatDate }}</span>
              {{ if t.resolvedAt }}
                <span class="text-base-content/30">·</span>
                <span class="text-success tabular-nums">resolvida {{ t.resolvedAt |> formatDate }}</span>
              {{ /if }}
            </div>
          </div>

          {{# Em mobile a pill encolhe só para o ponto colorido (label esconde-se). #}}
          <div class="flex items-center gap-2 shrink-0 mt-0.5">
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full whitespace-nowrap {{ badge.classes }}" style="{{ badge.style }}">
              <span class="w-1.5 h-1.5 rounded-full {{ if !badge.dot }}bg-current{{ /if }}" style="{{ badge.dot }}"></span>
              <span class="hidden sm:inline">{{ statusLabels[t.status] ?? t.status }}</span>
            </span>
            <svg class="w-4 h-4 text-base-content/30" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </div>
      </a>
    {{ /for }}
  </div>
{{ /if }}

{{# ─── Modal: Nova ocorrência ────────────────────────────────────────── #}}
<dialog id="modal_new_ticket" class="modal">
  <div class="modal-box max-w-lg">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fechar">✕</button>
    </form>
    <h3 class="font-bold text-lg mb-1">Nova ocorrência</h3>
    <p class="text-xs text-base-content/60 mb-4">
      Descreve o problema com o máximo de detalhe possível. O administrador será notificado.
    </p>
    <form method="post" action="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/tickets" class="space-y-3">
      <div class="form-control">
        <label class="label py-1" for="title"><span class="label-text text-xs font-medium">Título *</span></label>
        <input type="text" id="title" name="title" required minlength="3" maxlength="200"
               placeholder="Ex.: Lâmpada do hall fundida" class="input input-sm input-bordered">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label py-1" for="category"><span class="label-text text-xs font-medium">Categoria</span></label>
          <select id="category" name="category" class="select select-sm select-bordered">
            {{ for key, label of categoryLabels }}
              <option value="{{ key }}" {{ if key === "other" }}selected{{ /if }}>{{ label }}</option>
            {{ /for }}
          </select>
        </div>
        <div class="form-control">
          <label class="label py-1" for="priority"><span class="label-text text-xs font-medium">Prioridade</span></label>
          <select id="priority" name="priority" class="select select-sm select-bordered">
            {{ for key, label of priorityLabels }}
              <option value="{{ key }}" {{ if key === "normal" }}selected{{ /if }}>{{ label }}</option>
            {{ /for }}
          </select>
        </div>
      </div>
      <div class="form-control">
        <label class="label py-1" for="location"><span class="label-text text-xs font-medium">Localização</span></label>
        <input type="text" id="location" name="location" maxlength="120"
               placeholder="Ex.: Hall do 2º piso" class="input input-sm input-bordered">
      </div>
      <div class="form-control">
        <label class="label py-1" for="description"><span class="label-text text-xs font-medium">Descrição</span></label>
        <textarea id="description" name="description" rows="4" maxlength="2000"
                  placeholder="Detalhe do problema, quando começou, etc."
                  class="textarea textarea-sm textarea-bordered"></textarea>
      </div>
      <div class="flex justify-end gap-2 pt-2 border-t border-base-200">
        <button type="button" class="btn btn-sm btn-ghost"
                onclick="document.getElementById('modal_new_ticket').close()">Cancelar</button>
        <button type="submit" class="btn btn-sm btn-primary">Registar</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

{{ /layout }}
