{{ layout "layouts/portal.vto" { title, section, condominium, unit, currentUser, currentPortalUnitId, currentCondominiumId } }}

{{# `itemType` → label + classes do badge (mapa, para evitar `{{ if }}` no markup). #}}
{{ set itemTypeLabels = {
  approve_budget: "Aprovar orçamento",
  accounts_approval: "Aprovação de contas",
  admin_election: "Eleição administração",
  approve_fcr_usage: "Aprovar uso FCR",
  info: "Informativo",
  other: "Outra"
} }}
{{ set itemTypeBadge = {
  approve_budget: "bg-info/10 text-info border-info/20",
  accounts_approval: "bg-success/10 text-success border-success/20",
  admin_election: "bg-primary/10 text-primary border-primary/20",
  approve_fcr_usage: "bg-indigo-50 text-indigo-600 border-indigo-200",
  info: "bg-info/10 text-info border-info/20",
  other: "bg-base-200 text-base-content/70 border-base-300"
} }}

{{# ─── Cabeçalho ───────────────────────────────────────────────────────
   Chevrons só aparecem se houver ano anterior/posterior em `availableYears`. #}}
{{ set yearIdx = filterYear ? availableYears.indexOf(filterYear) : -1 }}
{{ set prevYear = yearIdx >= 0 && yearIdx < availableYears.length - 1 ? availableYears[yearIdx + 1] : null }}
{{ set nextYear = yearIdx > 0 ? availableYears[yearIdx - 1] : null }}

<div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-3 mb-6">
  <div>
    <h1 class="text-2xl sm:text-3xl font-black">Assembleias</h1>
    <p class="text-sm text-base-content/60 mt-1 max-w-xl">
      Histórico de decisões e orçamentos aprovados em assembleia de condóminos.
    </p>
  </div>
  {{ if availableYears && availableYears.length > 0 }}
    <div class="inline-flex items-center gap-1 rounded-lg border border-base-200 bg-base-100 px-1 py-1 shadow-sm">
      <a href="?{{ if prevYear }}year={{ String(prevYear) }}{{ else }}year={{ String(filterYear ?? '') }}{{ /if }}"
         class="btn btn-xs btn-ghost px-2 {{ if !prevYear }}pointer-events-none opacity-30{{ /if }}"
         aria-label="Ano anterior">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <form method="get" class="m-0">
        <select name="year" class="select select-xs select-ghost min-h-0 h-7 px-1 font-bold tabular-nums focus:outline-none"
                onchange="this.form.submit()">
          <option value="" {{ if !filterYear }}selected{{ /if }}>Todos</option>
          {{ for y of availableYears }}
            <option value="{{ String(y) }}" {{ if filterYear === y }}selected{{ /if }}>{{ String(y) }}</option>
          {{ /for }}
        </select>
      </form>
      <a href="?{{ if nextYear }}year={{ String(nextYear) }}{{ else }}year={{ String(filterYear ?? '') }}{{ /if }}"
         class="btn btn-xs btn-ghost px-2 {{ if !nextYear }}pointer-events-none opacity-30{{ /if }}"
         aria-label="Ano seguinte">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  {{ /if }}
</div>

{{# ─── Convocatórias por consultar ─────────────────────────────────────
   Convocadas com convocatória enviada. Sempre no topo (não filtradas por
   ano - negócio em curso); é onde aterra o condómino que vem pelo email. #}}
{{ if convokedAssemblies.length > 0 }}
  <section class="mb-8">
    <h2 class="text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-3">
      Convocatórias <span class="text-base-content/30 font-normal">· {{ String(convokedAssemblies.length) }}</span>
    </h2>
    <div class="space-y-3">
      {{ for a of convokedAssemblies }}
        <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/assemblies/{{ a.id }}"
           class="block bg-base-100 rounded-xl border border-base-200 shadow-sm hover:border-warning/40 transition-colors p-4 sm:p-5">
          <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
            <div class="min-w-0 flex-1">
              <h3 class="font-bold text-base flex items-center gap-2 flex-wrap">
                Assembleia {{ if a.type === "ordinary" }}Ordinária{{ else }}Extraordinária{{ /if }}
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-warning">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-warning"></span>Convocada
                </span>
              </h3>
              <div class="text-xs text-base-content/60 mt-1 flex items-center gap-1.5 flex-wrap">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                <span class="tabular-nums">{{ a.scheduledAt |> formatDateTime }}</span>
                {{ if a.location }}<span class="text-base-content/30">·</span><span>{{ a.location }}</span>{{ /if }}
              </div>
            </div>
            <span class="link link-primary text-xs font-semibold inline-flex items-center gap-1 shrink-0">
              Ver convocatória
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {{ /for }}
    </div>
  </section>
{{ /if }}

{{ if filterYear && approvedBudgets.length === 0 && heldAssemblies.length === 0 && convokedAssemblies.length === 0 }}
  <div class="bg-base-100 rounded-xl border border-base-200 p-8 text-center text-sm text-base-content/50 mb-6">
    Sem registos para o ano <strong>{{ String(filterYear) }}</strong>.
  </div>
{{ /if }}

{{# ─── Orçamentos aprovados ───────────────────────────────────────────── #}}
{{ if approvedBudgets.length > 0 }}
  <section class="mb-8">
    <h2 class="text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-3">
      Orçamentos aprovados <span class="text-base-content/30 font-normal">· {{ String(approvedBudgets.length) }}</span>
    </h2>

    <div class="space-y-4">
      {{ for b of approvedBudgets }}
        {{ set grandTotal = Number(b.totalAmount || 0) + Number(b.fcrAmount || 0) }}
        {{ set monthly = grandTotal / 12 }}
        <div id="budget-{{ b.id }}"
             class="bg-base-100 rounded-xl border border-base-200 shadow-sm overflow-hidden scroll-mt-32">
          <div class="px-5 py-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
            <div class="min-w-0 flex-1">
              {{# `items-center` (não `items-baseline`): pill com py-0.5 fica "caído" na baseline. #}}
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-bold text-xl leading-none">Orçamento {{ b.year }}</h3>
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full bg-success/10 text-success border border-success/20 whitespace-nowrap">
                  ● Aprovado em assembleia
                </span>
                {{ if b.type === "suplementar" }}
                  <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-200">Suplementar</span>
                {{ /if }}
              </div>
              <div class="text-xs text-base-content/60 mt-1 flex items-center gap-1.5 flex-wrap">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                {{ if b.approvedAt }}Aprovado em <strong class="text-base-content/80 tabular-nums">{{ b.approvedAt |> formatDate }}</strong>{{ /if }}
                <span class="text-base-content/30">·</span>
                <span>FCR {{ b.fcrPercentage }}%</span>
                {{ if b.quotasGeneratedAt }}
                  <span class="text-base-content/30">·</span>
                  <span>Quotas geradas em <strong class="text-base-content/80 tabular-nums">{{ b.quotasGeneratedAt |> formatDate }}</strong></span>
                {{ /if }}
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-[10px] uppercase tracking-wider text-base-content/50">Total anual</div>
              <div class="font-black text-2xl sm:text-3xl tabular-nums text-success">{{ grandTotal |> formatMoney }}</div>
              <div class="text-[11px] text-base-content/50 tabular-nums">≈ {{ monthly |> formatMoney }} / mês</div>
            </div>
          </div>

          {{# Breakdown só ordinário + FCR (budget lines não vêm da API portal).
             Taxa FCR no label, não como % do total: é sobre o ordinário. #}}
          {{ if Number(b.totalAmount || 0) > 0 || Number(b.fcrAmount || 0) > 0 }}
            <div class="grid grid-cols-2 gap-3 sm:gap-6 px-5 pb-4 border-t border-base-200 pt-4">
              <div>
                <div class="text-[10px] uppercase tracking-wider text-base-content/50">Orçamento ordinário</div>
                <div class="font-bold tabular-nums mt-1">{{ b.totalAmount |> formatMoney }}</div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider text-base-content/50">Fundo Comum Reserva (FCR · {{ b.fcrPercentage }}%)</div>
                <div class="font-bold tabular-nums mt-1">{{ b.fcrAmount |> formatMoney }}</div>
              </div>
            </div>
          {{ /if }}

          {{# Rodapé do card com hint sobre quotas + link para detalhe. #}}
          <div class="px-5 py-3 border-t border-base-200 bg-base-200/30 flex items-center justify-between gap-3 flex-wrap text-xs">
            {{ if b.quotasGeneratedAt }}
              <span class="text-success/90 inline-flex items-center gap-1.5">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
                Quotas geradas e lançadas · 12 mensalidades de <strong class="tabular-nums">{{ monthly |> formatMoney }}</strong>
              </span>
            {{ else }}
              <span class="text-base-content/50 inline-flex items-center gap-1.5">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/30"></span>
                Quotas ainda por gerar
              </span>
            {{ /if }}
            <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/budgets/{{ b.id }}"
               class="link link-primary font-semibold inline-flex items-center gap-1">
              Ver detalhes
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      {{ /for }}
    </div>
  </section>
{{ /if }}

{{# ─── Assembleias realizadas ─────────────────────────────────────────── #}}
{{ if heldAssemblies.length > 0 }}
  <section>
    <h2 class="text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-3">
      Assembleias realizadas <span class="text-base-content/30 font-normal">· {{ String(heldAssemblies.length) }}</span>
    </h2>

    <div class="space-y-5">
      {{ for a of heldAssemblies }}
        {{ set totalDecisions = a.agendaItems ? a.agendaItems.length : 0 }}
        {{ set approvedDecisions = a.agendaItems ? a.agendaItems.filter((d) => d.approved === true).length : 0 }}
        {{ set rejectedDecisions = a.agendaItems ? a.agendaItems.filter((d) => d.approved === false).length : 0 }}
        {{ set infoDecisions = a.agendaItems ? a.agendaItems.filter((d) => d.itemType === "info").length : 0 }}
        {{ set minutesAttachment = a.attachments ? a.attachments.find((f) => f.mimeType === "application/pdf") : null }}

        <article class="bg-base-100 rounded-xl border border-base-200 shadow-sm overflow-hidden">
          <div class="px-5 py-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-3 border-b border-base-200">
            <div class="min-w-0 flex-1">
              <h3 class="font-bold text-lg flex items-baseline gap-2 flex-wrap">
                Assembleia {{ if a.type === "ordinary" }}Ordinária{{ else }}Extraordinária{{ /if }}
                {{ if a.minutesNumber }}
                  <span class="text-xs font-normal text-base-content/60">Ata nº {{ a.minutesNumber }}</span>
                {{ /if }}
              </h3>
              <div class="text-xs text-base-content/60 mt-1 flex items-center gap-1.5 flex-wrap">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                <span class="tabular-nums">{{ a.scheduledAt |> formatDate }}</span>
                {{ if a.location }}
                  <span class="text-base-content/30">·</span>
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                  <span>{{ a.location }}</span>
                {{ /if }}
                {{ if totalDecisions > 0 }}
                  <span class="text-base-content/30">·</span>
                  <span>{{ String(totalDecisions) }} {{ totalDecisions === 1 ? "ponto na ordem do dia" : "pontos na ordem do dia" }}</span>
                {{ /if }}
              </div>
            </div>
            <div class="flex items-center gap-3 flex-wrap shrink-0">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-success">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>Realizada
              </span>
              {{ if minutesAttachment }}
                <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/assemblies/{{ a.id }}/attachments/{{ minutesAttachment.id }}"
                   target="_blank"
                   class="btn btn-xs btn-ghost gap-1 normal-case font-medium">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                  Descarregar ata
                </a>
              {{ /if }}
            </div>
          </div>

          {{# Resumo de quórum (Art. 1432.º nº 1 CC) - permilagem presente agregada, sem identidades. #}}
          {{ if a.attendeeSummary && a.attendeeSummary.count > 0 }}
            {{ set sum = a.attendeeSummary }}
            {{ set quorumPct = sum.totalBuildingPermillage > 0
              ? Math.round((sum.totalPermillage * 1000 / sum.totalBuildingPermillage)) / 10
              : 0 }}
            {{ set quorumMet = sum.convocationRound === "first"
              ? sum.totalPermillage > sum.totalBuildingPermillage / 2
              : sum.totalPermillage > 0 }}
            <div class="px-5 py-3 border-b border-base-200 bg-base-200/20 flex items-center gap-4 flex-wrap text-xs">
              <div class="inline-flex items-center gap-1.5 text-base-content/70">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                <span class="font-semibold tabular-nums">{{ String(sum.count) }}</span>
                {{ sum.count === 1 ? "presente" : "presentes" }}
              </div>
              <span class="text-base-content/30">·</span>
              <div class="text-base-content/70">
                Permilagem presente:
                <strong class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded font-bold tabular-nums {{ if quorumMet }}bg-success/10 text-success{{ else }}bg-error/10 text-error{{ /if }}">
                  {{ String(sum.totalPermillage.toFixed(3)) }}
                </strong>
                / <span class="tabular-nums">{{ String(sum.totalBuildingPermillage.toFixed(3)) }}</span> ‰
                <span class="text-base-content/40 ml-1">({{ String(quorumPct.toFixed(1)) }}%)</span>
              </div>
              <span class="text-base-content/30">·</span>
              <span class="text-[10px] uppercase tracking-wider font-bold text-base-content/50">
                {{ sum.convocationRound === "second" ? "2ª convocatória" : "1ª convocatória" }}
              </span>
            </div>
          {{ /if }}

          {{# Abertura. Texto longo (>240 chars) entra num <details> para não empurrar o resto. #}}
          {{ if a.introduction }}
            <div class="px-5 py-3 border-b border-base-200/60">
              <div class="text-[10px] uppercase tracking-widest font-bold text-base-content/50 mb-1.5">Abertura</div>
              {{ set introLong = a.introduction.length > 240 }}
              {{ if introLong }}
                {{# `whitespace-pre-line` nos spans de texto, não no `<summary>`: senão o whitespace entre spans vira quebras visíveis. #}}
                <details class="group">
                  <summary class="cursor-pointer list-none text-sm text-base-content/80 leading-relaxed"><span class="whitespace-pre-line group-open:hidden">{{ a.introduction.slice(0, 240) }}…</span><span class="hidden whitespace-pre-line group-open:inline">{{ a.introduction }}</span> <span class="link link-primary text-xs font-medium align-baseline"><span class="group-open:hidden">ver mais</span><span class="hidden group-open:inline">ver menos</span></span></summary>
                </details>
              {{ else }}
                <p class="text-sm text-base-content/80 leading-relaxed whitespace-pre-line">{{ a.introduction }}</p>
              {{ /if }}
            </div>
          {{ /if }}

          {{ if totalDecisions > 0 }}
            <div class="px-5 py-2 border-b border-base-200/60 text-[10px] uppercase tracking-widest font-bold text-base-content/50">
              Ordem do dia <span class="text-base-content/30 font-normal normal-case tracking-normal">· {{ String(totalDecisions) }}</span>
            </div>
            <ul class="divide-y divide-base-200">
              {{ for d of a.agendaItems }}
                {{ set vFav = (d.votesInFavor != null && d.votesInFavor !== "") ? Number(d.votesInFavor) : null }}
                {{ set vAg = (d.votesAgainst != null && d.votesAgainst !== "") ? Number(d.votesAgainst) : null }}
                {{ set vAb = (d.votesAbstain != null && d.votesAbstain !== "") ? Number(d.votesAbstain) : null }}
                {{ set votesHidden = d.itemType === "info" || (vFav == null && vAg == null && vAb == null) }}
                {{ set dResult = d.itemType === "info" ? "info" : (d.approved === true ? "approved" : (d.approved === false ? "rejected" : "pending")) }}
                <li class="px-5 py-4">
                  <div class="flex items-baseline gap-3 mb-1.5">
                    <span class="text-base-content/40 tabular-nums text-sm font-semibold shrink-0 mt-0.5">{{ d.sequence }}</span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="font-semibold text-sm break-words">{{ d.subject }}</span>
                        {{ if d.itemType && itemTypeLabels[d.itemType] }}
                          <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider border whitespace-nowrap {{ itemTypeBadge[d.itemType] ?? 'bg-base-200 border-base-300' }}">
                            {{ itemTypeLabels[d.itemType] }}
                          </span>
                        {{ /if }}
                        {{ if dResult === "approved" }}
                          <span class="inline-flex items-center gap-1 text-xs font-semibold text-success">● Aprovada</span>
                        {{ else if dResult === "rejected" }}
                          <span class="inline-flex items-center gap-1 text-xs font-semibold text-error">● Rejeitada</span>
                        {{ else if dResult === "info" }}
                          <span class="inline-flex items-center gap-1 text-xs font-semibold text-info">● Informativo</span>
                        {{ else }}
                          <span class="inline-flex items-center gap-1 text-xs text-base-content/60">● Pendente</span>
                        {{ /if }}
                        {{ if d.refType === "budget" && d.refId }}
                          {{ set linkedBudget = approvedBudgets.find((b) => b.id === d.refId) }}
                          {{ if linkedBudget }}
                            <a href="#budget-{{ linkedBudget.id }}"
                               class="text-xs text-primary hover:underline font-medium whitespace-nowrap">
                              → Orçamento {{ linkedBudget.year }}
                            </a>
                          {{ /if }}
                        {{ /if }}
                      </div>

                      {{# Votação - só para deliberações com votos registados (não info, não pendente sem dados). #}}
                      {{ if !votesHidden }}
                        <div class="flex items-center gap-3 mt-1.5 text-xs text-base-content/70" title="Favor / Contra / Abstenção">
                          {{ if vFav != null }}
                            <span class="inline-flex items-center gap-1 text-success">
                              <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 3l7 11H3z"/></svg>
                              <span class="tabular-nums font-semibold">{{ String(vFav) }}</span> a favor
                            </span>
                          {{ /if }}
                          {{ if vAg != null }}
                            <span class="inline-flex items-center gap-1 text-error">
                              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                              <span class="tabular-nums font-semibold">{{ String(vAg) }}</span> contra
                            </span>
                          {{ /if }}
                          {{ if vAb != null }}
                            <span class="inline-flex items-center gap-1 text-base-content/60">
                              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
                              <span class="tabular-nums font-semibold">{{ String(vAb) }}</span> abstenção
                            </span>
                          {{ /if }}
                        </div>
                      {{ /if }}

                      {{# Descrição >180 chars: teaser + modal com texto completo. #}}
                      {{ if d.description }}
                        {{ if d.description.length > 180 }}
                          <p class="text-xs text-base-content/70 mt-2 leading-relaxed">
                            {{ d.description.slice(0, 180) }}…
                            <button type="button"
                                    class="text-primary text-[11px] font-medium hover:underline ml-1 align-baseline"
                                    onclick="document.getElementById('dec_modal_{{ d.id }}').showModal()">ver mais</button>
                          </p>
                          <dialog id="dec_modal_{{ d.id }}" class="modal">
                            <div class="modal-box max-w-2xl">
                              <form method="dialog">
                                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fechar">✕</button>
                              </form>
                              <h3 class="font-bold text-lg mb-2">
                                <span class="text-base-content/40 tabular-nums mr-2">{{ d.sequence }}.</span>{{ d.subject }}
                              </h3>
                              <p class="text-base text-base-content/80 leading-relaxed whitespace-pre-line mt-3">{{ d.description }}</p>
                              <div class="flex justify-end pt-4 mt-4 border-t border-base-200">
                                <form method="dialog"><button class="btn btn-sm btn-primary">Fechar</button></form>
                              </div>
                            </div>
                            <form method="dialog" class="modal-backdrop"><button>close</button></form>
                          </dialog>
                        {{ else }}
                          <p class="text-xs text-base-content/70 mt-2 leading-relaxed whitespace-pre-line">{{ d.description }}</p>
                        {{ /if }}
                      {{ /if }}
                    </div>
                  </div>
                </li>
              {{ /for }}
            </ul>
          {{ else }}
            <div class="px-5 py-4 text-xs text-base-content/50 text-center">
              Sem pontos na ordem do dia.
            </div>
          {{ /if }}

          {{# Encerramento - mesmo accordion da Abertura. #}}
          {{ if a.conclusion }}
            <div class="px-5 py-3 border-t border-base-200/60">
              <div class="text-[10px] uppercase tracking-widest font-bold text-base-content/50 mb-1.5">Encerramento</div>
              {{ set conclLong = a.conclusion.length > 240 }}
              {{ if conclLong }}
                <details class="group">
                  <summary class="cursor-pointer list-none text-sm text-base-content/80 leading-relaxed"><span class="whitespace-pre-line group-open:hidden">{{ a.conclusion.slice(0, 240) }}…</span><span class="hidden whitespace-pre-line group-open:inline">{{ a.conclusion }}</span> <span class="link link-primary text-xs font-medium align-baseline"><span class="group-open:hidden">ver mais</span><span class="hidden group-open:inline">ver menos</span></span></summary>
                </details>
              {{ else }}
                <p class="text-sm text-base-content/80 leading-relaxed whitespace-pre-line">{{ a.conclusion }}</p>
              {{ /if }}
            </div>
          {{ /if }}

          {{# Assinatura da ata (Art. 1434.º CC). #}}
          {{ if a.minutesSignedAt }}
            <div class="px-5 py-3 border-t border-base-200/60 bg-base-200/30 text-xs text-base-content/70">
              <div class="text-[10px] uppercase tracking-widest font-bold text-base-content/50 mb-2">Assinatura da ata</div>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                {{ if a.presidentOccupant }}
                  <span><span class="text-base-content/50">Presidente:</span> <strong class="text-base-content/90">{{ a.presidentOccupant.name }}</strong></span>
                {{ /if }}
                {{ if a.secretaryOccupant }}
                  <span><span class="text-base-content/50">Secretário:</span> <strong class="text-base-content/90">{{ a.secretaryOccupant.name }}</strong></span>
                {{ /if }}
                <span class="tabular-nums"><span class="text-base-content/50">Assinada em:</span> <strong class="text-base-content/90">{{ a.minutesSignedAt |> formatDate }}</strong></span>
              </div>
            </div>
          {{ /if }}

          {{# Anexos extra - os restantes ficheiros, além da ata PDF já no cabeçalho. #}}
          {{ set extraAttachments = a.attachments ? a.attachments.filter((f) => !minutesAttachment || f.id !== minutesAttachment.id) : [] }}
          {{ if extraAttachments.length > 0 }}
            <div class="px-5 py-3 border-t border-base-200 bg-base-200/20">
              <div class="text-[10px] uppercase tracking-wider font-bold text-base-content/50 mb-2">Anexos adicionais</div>
              <ul class="space-y-1.5">
                {{ for f of extraAttachments }}
                  <li class="flex items-center justify-between gap-3">
                    <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/assemblies/{{ a.id }}/attachments/{{ f.id }}"
                       target="_blank"
                       class="flex items-center gap-2 text-sm hover:text-primary min-w-0 flex-1">
                      {{ if f.mimeType && f.mimeType.startsWith("image/") }}
                        <span title="Imagem">🖼️</span>
                      {{ else if f.mimeType === "application/pdf" }}
                        <span title="PDF">📄</span>
                      {{ else }}
                        <span title="Ficheiro">📎</span>
                      {{ /if }}
                      <span class="truncate">{{ f.filename }}</span>
                    </a>
                    {{ if f.fileSize }}
                      <span class="text-[11px] text-base-content/40 shrink-0">{{ String(Math.round(Number(f.fileSize) / 1024)) }} KB</span>
                    {{ /if }}
                  </li>
                {{ /for }}
              </ul>
            </div>
          {{ /if }}
        </article>
      {{ /for }}
    </div>
  </section>
{{ /if }}

{{ if approvedBudgets.length === 0 && heldAssemblies.length === 0 && convokedAssemblies.length === 0 && !filterYear }}
  <div class="bg-base-100 rounded-xl border border-base-200 p-12 text-center">
    <div class="text-5xl mb-3 opacity-30">🏛️</div>
    <p class="text-base-content/60">Ainda não há registos de assembleias.</p>
  </div>
{{ /if }}

{{ /layout }}
