{{ layout "layouts/portal.vto" { title, section, condominium, unit, currentUser, currentPortalUnitId, currentCondominiumId } }}

{{ set typeLabels = { quota: "Quota", extraordinary_quota: "Quota extra", interest: "Juros", refacturation: "Refaturação", credit_balance: "Crédito", supplier_service: "Serviço", opening_balance_debit: "Saldo anterior" } }}
{{# Totais excluem linhas estornadas. #}}
{{ set totalIn = bankBreakdown.filter((b) => !b.reversed && Number(b.bankAmount) > 0).reduce((s, b) => s + Number(b.bankAmount), 0) }}
{{ set totalOut = bankBreakdown.filter((b) => !b.reversed && Number(b.bankAmount) < 0).reduce((s, b) => s + Math.abs(Number(b.bankAmount)), 0) }}
{{ set withReceipt = bankBreakdown.filter((b) => !b.reversed && Number(b.bankAmount) > 0 && b.receipt).length }}
{{ set pendingReceipt = bankBreakdown.filter((b) => !b.reversed && Number(b.bankAmount) > 0 && !b.receipt).length }}

<div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2 mb-4">
  <div>
    <h1 class="text-2xl sm:text-3xl font-black">Extrato bancário</h1>
    <div class="text-sm text-base-content/60 mt-1">
      {{ String(bankBreakdown.length) }} {{ if filterYear }}movimentos em {{ String(filterYear) }}{{ else }}movimentos no total{{ /if }}
      {{ if totalIn > 0 }} · <strong class="text-base-content/90">{{ totalIn |> formatMoney }}</strong> entrados{{ /if }}
    </div>
  </div>
</div>

<div class="flex items-center gap-3 flex-wrap mb-4">
  {{ if availableYears && availableYears.length > 0 }}
    <form method="get" class="flex items-center gap-2">
      <label for="filter_year" class="text-xs uppercase tracking-wider font-bold text-base-content/60">Ano</label>
      <select id="filter_year" name="year" class="select select-sm select-bordered"
              onchange="this.form.submit()">
        <option value="" {{ if !filterYear }}selected{{ /if }}>Todos</option>
        {{ for y of availableYears }}
          <option value="{{ String(y) }}" {{ if filterYear === y }}selected{{ /if }}>{{ String(y) }}</option>
        {{ /for }}
      </select>
    </form>
  {{ /if }}

  {{ if bankBreakdown.length > 0 }}
    <div class="flex items-center gap-3 flex-wrap text-xs">
      {{ if withReceipt > 0 }}
        <span class="inline-flex items-center gap-1.5 text-success font-medium">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
          <span class="tabular-nums">{{ String(withReceipt) }}</span> com recibo
        </span>
      {{ /if }}
      {{ if pendingReceipt > 0 }}
        <span class="inline-flex items-center gap-1.5 text-base-content/70 font-medium">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/40"></span>
          <span class="tabular-nums">{{ String(pendingReceipt) }}</span> sem recibo
        </span>
      {{ /if }}
    </div>

    <button type="button" data-statement-toggle class="btn btn-xs btn-ghost gap-1 ml-auto" data-state="closed">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
      <span data-toggle-label>Expandir tudo</span>
    </button>
  {{ /if }}
</div>

{{ if bankBreakdown.length === 0 }}
  <div class="bg-base-100 rounded-xl border border-base-200 p-12 text-center">
    <div class="text-5xl mb-3 opacity-30">🏦</div>
    {{ if filterYear }}
      <p class="text-base-content/60">Sem movimentos para o ano {{ String(filterYear) }}.</p>
      <p class="text-xs text-base-content/40 mt-2">Escolhe outro ano ou "Todos" para veres tudo.</p>
    {{ else }}
      <p class="text-base-content/60">Ainda sem movimentos bancários conciliados para esta fração.</p>
    {{ /if }}
  </div>
{{ else }}
  <div class="bg-base-100 rounded-xl border border-base-200 shadow-sm overflow-hidden" data-statement-scope>
    {{# 1ª coluna placeholder (24px) alinha com o chevron de cada linha. #}}
    <div class="hidden md:grid grid-cols-[24px_90px_1fr_100px_180px] gap-3 px-4 py-2.5 border-b border-base-200 bg-base-200/50 text-base-content/70 text-[10px] uppercase tracking-widest font-semibold">
      <div></div>
      <div>Data</div>
      <div>Descrição</div>
      <div class="text-right">Valor</div>
      <div class="pl-6">Recibo</div>
    </div>

    <div class="divide-y divide-base-200">
      {{ for bk of bankBreakdown }}
        {{ set hasAllocations = bk.allocations && bk.allocations.length > 0 }}
        <details class="group {{ if bk.reversed }}opacity-60{{ /if }}" data-statement-row>
          <summary class="cursor-pointer list-none px-4 py-3 hover:bg-base-200/40 transition-colors
                          grid grid-cols-[24px_1fr_auto] md:grid-cols-[24px_90px_1fr_100px_180px]
                          gap-3 items-center text-sm">
            <svg class="w-3 h-3 text-base-content/40 transition-transform group-open:rotate-90 {{ if !hasAllocations }}opacity-30{{ /if }}" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>

            {{# Mobile: descrição + meta empilhadas; valor à direita. #}}
            <div class="md:hidden min-w-0">
              <div class="font-medium leading-snug line-clamp-2">{{ bk.description ?? "-" }}</div>
              <div class="text-xs text-base-content/60 flex items-center gap-1.5 flex-wrap mt-1">
                <span class="tabular-nums">{{ bk.transactionDate |> formatDate }}</span>
                {{ if bk.reversed }}
                  <span class="text-base-content/30">·</span>
                  <span class="uppercase tracking-wider font-semibold text-error/80">estornado</span>
                {{ /if }}
                {{ if bk.bankAmount > 0 && !bk.reversed }}
                  <span class="text-base-content/30">·</span>
                  {{ if bk.receipt }}
                    <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/receipts/{{ bk.receipt.id }}/pdf"
                       target="_blank" rel="noopener"
                       class="text-success font-semibold inline-flex items-center gap-1"
                       onclick="event.stopPropagation()">
                      Recibo Nº {{ bk.receipt.number }}
                    </a>
                  {{ else }}
                    <span class="text-base-content/50 italic">recibo pendente</span>
                  {{ /if }}
                {{ /if }}
              </div>
            </div>
            <div class="md:hidden text-sm font-bold tabular-nums whitespace-nowrap shrink-0
                        {{ if bk.bankAmount < 0 }}text-error/80{{ else }}text-success/80{{ /if }}">
              {{ bk.bankAmount |> formatMoney }}
            </div>

            <div class="hidden md:block text-base-content/70 whitespace-nowrap tabular-nums text-xs">{{ bk.transactionDate |> formatDate }}</div>
            <div class="hidden md:block min-w-0 truncate font-medium" title="{{ bk.description ?? '' }}">
              {{ bk.description ?? "-" }}
              {{ if bk.reversed }}
                <span class="inline-flex items-center gap-1 ml-2 text-[10px] uppercase tracking-wider font-semibold text-error/80">estornado</span>
              {{ /if }}
            </div>
            <div class="hidden md:block text-right tabular-nums whitespace-nowrap font-semibold
                        {{ if bk.bankAmount < 0 }}text-error/80{{ else }}text-success/80{{ /if }}">
              {{ bk.bankAmount |> formatMoney }}
            </div>
            {{# pl-6 afasta a coluna Recibo do "Valor" à esquerda. #}}
            <div class="hidden md:block text-xs pl-6">
              {{ if bk.bankAmount > 0 && !bk.reversed }}
                {{ if bk.receipt }}
                  <a href="/portal/c/{{ currentCondominiumId }}/u/{{ currentPortalUnitId }}/receipts/{{ bk.receipt.id }}/pdf"
                     target="_blank" rel="noopener"
                     class="inline-flex items-center gap-1.5 text-success font-semibold hover:underline"
                     onclick="event.stopPropagation()"
                     title="Abrir PDF do recibo">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <span class="tabular-nums">Nº {{ bk.receipt.number }}</span>
                    <svg class="w-3 h-3 opacity-70 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
                    </svg>
                  </a>
                {{ else }}
                  <span class="inline-flex items-center gap-1.5 text-base-content/50 italic">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/30"></span>
                    Ainda não emitido
                  </span>
                {{ /if }}
              {{ else }}
                <span class="text-base-content/30">-</span>
              {{ /if }}
            </div>
          </summary>

          {{# Expandido: alocações (cobranças liquidadas) deste movimento. #}}
          {{ if hasAllocations }}
            <div class="px-4 pb-4 pt-1 bg-base-200/20 border-t border-base-200/60">
              <div class="ml-7 md:ml-9">
                <div class="text-[10px] uppercase tracking-wider font-bold text-base-content/50 mb-2">
                  Liquidações · {{ String(bk.allocations.length) }}
                </div>
                <ul class="space-y-1.5">
                  {{ for a of bk.allocations }}
                    <li class="flex items-baseline gap-3 text-xs flex-wrap {{ if a.status === 'reversed' }}line-through opacity-60{{ /if }}">
                      <span class="text-success/80 shrink-0">↳</span>
                      <span class="text-base-content/80 truncate flex-1 min-w-0" title="{{ a.description }}">
                        <span class="font-medium">{{ a.description }}</span>
                        <span class="text-base-content/50"> · {{ typeLabels[a.chargeType] ?? a.chargeType }}</span>
                      </span>
                      <span class="tabular-nums font-semibold whitespace-nowrap">{{ a.amount |> formatMoney }}</span>
                    </li>
                  {{ /for }}
                </ul>
              </div>
            </div>
          {{ /if }}
        </details>
      {{ /for }}
    </div>

    <div class="border-t border-base-200 px-4 py-3 bg-base-200/30 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-xs text-base-content/70">
      <div>
        <strong class="text-base-content/90 tabular-nums">{{ String(bankBreakdown.length) }}</strong>
        {{ bankBreakdown.length === 1 ? "movimento" : "movimentos" }}
      </div>
      <div>
        {{ if totalIn > 0 }}
          <strong class="text-success tabular-nums">{{ totalIn |> formatMoney }}</strong>
          entrados{{ if totalOut > 0 }} <span class="text-base-content/30 mx-1">·</span>{{ /if }}
        {{ /if }}
        {{ if totalOut > 0 }}
          <strong class="text-error tabular-nums">{{ totalOut |> formatMoney }}</strong>
          saídos
        {{ /if }}
      </div>
    </div>
  </div>
{{ /if }}

<script>
  // Expandir/recolher todos os movimentos. Mesmo padrão da página de
  // cobranças (botão fora do scope, target via querySelector global).
  (function () {
    var btn = document.querySelector("[data-statement-toggle]");
    var scope = document.querySelector("[data-statement-scope]");
    if (!btn || !scope) return;
    var label = btn.querySelector("[data-toggle-label]");
    btn.addEventListener("click", function () {
      var willOpen = btn.dataset.state === "closed";
      scope.querySelectorAll("details[data-statement-row]").forEach(function (d) {
        d.open = willOpen;
      });
      btn.dataset.state = willOpen ? "open" : "closed";
      if (label) label.textContent = willOpen ? "Recolher tudo" : "Expandir tudo";
    });
  })();
</script>

{{ /layout }}
