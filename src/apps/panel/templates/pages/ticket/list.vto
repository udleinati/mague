{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

{{ layout "partials/page_header.vto" { title: "Ocorrências" } }}
  <a href="{{ '/tickets/new' |> condoPath }}" class="btn btn-sm btn-primary">+ Nova ocorrência</a>
{{ /layout }}

{{# KPI cards (4 estados). Paleta theme-aware (warning/info/success/base)
   com tinta /10 + texto da cor sólida - mantém o look discreto sem partir
   em dark mode (Tailwind hardcoded amber-50 etc. não adaptavam). #}}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
  <a href="{{ '/tickets?status=open' |> condoPath }}"
     class="bg-warning/10 rounded-xl border border-warning/30 p-5 hover:shadow-md transition-shadow">
    <div class="text-xs uppercase font-bold text-warning tracking-wider">Abertas</div>
    <div class="text-xl sm:text-2xl xl:text-3xl font-black mt-2 {{ if summary.open === 0 }}text-base-content/30{{ else }}text-warning{{ /if }}">{{ String(summary.open) }}</div>
    <div class="text-xs text-base-content/60 mt-1">por triar</div>
  </a>
  <a href="{{ '/tickets?status=in_progress' |> condoPath }}"
     class="bg-info/10 rounded-xl border border-info/30 p-5 hover:shadow-md transition-shadow">
    <div class="text-xs uppercase font-bold text-info tracking-wider">Em progresso</div>
    <div class="text-xl sm:text-2xl xl:text-3xl font-black mt-2 {{ if summary.in_progress === 0 }}text-base-content/30{{ else }}text-info{{ /if }}">{{ String(summary.in_progress) }}</div>
    <div class="text-xs text-base-content/60 mt-1">a tratar</div>
  </a>
  <a href="{{ '/tickets?status=resolved' |> condoPath }}"
     class="bg-success/10 rounded-xl border border-success/30 p-5 hover:shadow-md transition-shadow">
    <div class="text-xs uppercase font-bold text-success tracking-wider">Resolvidas</div>
    <div class="text-xl sm:text-2xl xl:text-3xl font-black mt-2 {{ if summary.resolved === 0 }}text-base-content/30{{ else }}text-success{{ /if }}">{{ String(summary.resolved) }}</div>
    <div class="text-xs text-base-content/60 mt-1">terminadas</div>
  </a>
  <a href="{{ '/tickets?status=closed' |> condoPath }}"
     class="bg-base-200 rounded-xl border border-base-300 p-5 hover:shadow-md transition-shadow">
    <div class="text-xs uppercase font-bold text-base-content/60 tracking-wider">Fechadas</div>
    <div class="text-xl sm:text-2xl xl:text-3xl font-black mt-2 {{ if summary.closed === 0 }}text-base-content/30{{ else }}text-base-content/70{{ /if }}">{{ String(summary.closed) }}</div>
    <div class="text-xs text-base-content/60 mt-1">arquivadas</div>
  </a>
</div>

<form method="get" class="flex flex-wrap gap-2 mb-4 items-end bg-base-100 rounded-xl border border-base-200 p-3 shadow-sm">
  <select name="status" class="select select-sm select-bordered" onchange="this.form.submit()">
    <option value="">Todos os estados</option>
    {{ for key, label of statusLabels }}
      <option value="{{ key }}" {{ if filters.status === key }}selected{{ /if }}>{{ label }}</option>
    {{ /for }}
  </select>
  <select name="category" class="select select-sm select-bordered" onchange="this.form.submit()">
    <option value="">Todas as categorias</option>
    {{ for key, label of categoryLabels }}
      <option value="{{ key }}" {{ if filters.category === key }}selected{{ /if }}>{{ label }}</option>
    {{ /for }}
  </select>
  <select name="priority" class="select select-sm select-bordered" onchange="this.form.submit()">
    <option value="">Todas as prioridades</option>
    {{ for key, label of priorityLabels }}
      <option value="{{ key }}" {{ if filters.priority === key }}selected{{ /if }}>{{ label }}</option>
    {{ /for }}
  </select>
  {{ if filters.status || filters.category || filters.priority }}
    <a href="{{ '/tickets' |> condoPath }}" class="btn btn-sm btn-ghost">Limpar</a>
  {{ /if }}
</form>

{{ if tickets.length === 0 }}
  <div class="bg-base-100 rounded-xl border border-base-200 shadow-sm p-12 text-center">
    <div class="text-5xl mb-3 text-base-content/30">🛠</div>
    <h2 class="text-xl font-bold mb-1">Sem ocorrências</h2>
    <p class="text-sm text-base-content/60 max-w-md mx-auto">Quando houver uma avaria ou reclamação, regista aqui para manter o histórico do condomínio.</p>
    <a href="{{ '/tickets/new' |> condoPath }}" class="btn btn-sm btn-primary mt-4">Nova ocorrência</a>
  </div>
{{ else }}
  <div class="bg-base-100 rounded-xl border border-base-200 overflow-hidden shadow-sm">
    <div class="table-scroll">
    <table class="table table-sm">
      <thead>
        <tr class="text-base-content/40 text-[10px] uppercase tracking-widest">
          <th class="pl-4">#</th>
          <th>Título</th>
          <th>Categoria</th>
          <th>Prioridade</th>
          <th>Estado</th>
          <th>Criado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ for t of tickets }}
          <tr class="hover:bg-base-200/30 border-t border-base-100 text-sm">
            <td class="pl-4 font-mono text-xs font-semibold tabular-nums">
              <a href="/admin/c/{{ currentCondominiumId }}/tickets/{{ t.id }}" class="link link-hover link-primary">{{ t.code }}</a>
            </td>
            <td>
              <div class="flex items-center gap-2 flex-wrap">
                <a href="{{ ('/tickets/' + t.id) |> condoPath }}" class="link link-hover font-semibold">{{ t.title }}</a>
                {{# Só destacamos `public` (visível a todos) - o caso
                   "ruidoso" que o admin deve identificar a olho na lista. #}}
                {{ if t.visibility === "public" }}
                  <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded bg-success/10 text-success">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    Visível a todos
                  </span>
                {{ /if }}
              </div>
              {{ if t.location }}<div class="text-xs text-base-content/50">{{ t.location }}</div>{{ /if }}
            </td>
            <td class="text-base-content/70">{{ categoryLabels[t.category] ?? t.category }}</td>
            <td>
              {{# Dot+texto subtil (convenção das listas; pills com fundo só
                 nas páginas de detalhe). #}}
              {{ set pColor = t.priority === "urgent" ? "error"
                : t.priority === "high" ? "warning"
                : t.priority === "low" ? "base-content/40"
                : "base-content/60" }}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-{{ pColor }}">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-{{ pColor }}"></span>{{ priorityLabels[t.priority] }}
              </span>
            </td>
            <td>
              {{ set sColor = t.status === "open" ? "warning"
                : t.status === "in_progress" ? "info"
                : t.status === "resolved" ? "success"
                : "base-content/40" }}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-{{ sColor }}">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-{{ sColor }}"></span>{{ statusLabels[t.status] }}
              </span>
            </td>
            <td class="text-xs text-base-content/60">{{ t.createdAt |> formatDate }}</td>
            <td class="pr-4 text-right">
              {{ include "partials/action_link.vto" {
                kind: "view",
                href: "/admin/c/" + currentCondominiumId + "/tickets/" + t.id,
              } }}
            </td>
          </tr>
        {{ /for }}
      </tbody>
    </table>
    </div>
  </div>
{{ /if }}

{{ /layout }}
