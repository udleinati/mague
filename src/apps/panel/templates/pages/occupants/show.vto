{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

{{# Header sem ações: a destrutiva vive na Zona perigosa (ADR 0036, ADR 0025). #}}
{{ include "partials/page_header.vto" {
  title: occupant.occupantName,
  scale: "detail",
  breadcrumbs: [
    { label: "Ocupantes", href: "/admin/c/" + currentCondominiumId + "/occupants" },
    { label: occupant.occupantName },
  ],
} }}

{{# Uma chip por relationship_type ativo (ADR 0018). Multi-badge fica fora
   do page_header (o `status` do partial é singular). #}}
<div class="-mt-4 mb-6 flex items-center gap-3 flex-wrap">
  {{ if occupant.units.length === 0 }}
    {{ include "partials/status_badge.vto" { label: "Sem fração", tone: "muted" } }}
  {{ else }}
    {{ if occupant.units.some((u) => u.relationshipType === "owner") }}
      {{ include "partials/status_badge.vto" { label: "Proprietário", tone: "success" } }}
    {{ /if }}
    {{ if occupant.units.some((u) => u.relationshipType === "tenant") }}
      {{ include "partials/status_badge.vto" { label: "Inquilino", tone: "warning" } }}
    {{ /if }}
    {{ if occupant.units.some((u) => u.relationshipType === "resident") }}
      {{ include "partials/status_badge.vto" { label: "Residente", tone: "info" } }}
    {{ /if }}
  {{ /if }}
</div>

{{# Tracking de login do ocupante, populado no auth handler.
   Só mostra se houver first_login ou last_login. #}}
{{ if occupant.occupantData.firstLoginAt || occupant.occupantData.lastLoginAt }}
  <div class="bg-base-100 rounded-xl border border-base-200 shadow-sm p-6 mb-6">
    <h2 class="text-sm font-semibold mb-4 flex items-center gap-2">
      <svg class="w-4 h-4 text-base-content/60" fill="currentColor" viewBox="0 0 20 20"><path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/></svg>
      Acesso ao portal
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div>
        <div class="text-xs text-base-content/50">Primeira vez</div>
        <div class="font-medium tabular-nums">{{ if occupant.occupantData.firstLoginAt }}{{ occupant.occupantData.firstLoginAt |> formatDate }}{{ else }}<span class="text-base-content/40">-</span>{{ /if }}</div>
      </div>
      <div>
        <div class="text-xs text-base-content/50">Última vez</div>
        <div class="font-medium tabular-nums">{{ if occupant.occupantData.lastLoginAt }}{{ occupant.occupantData.lastLoginAt |> formatDate }}{{ else }}<span class="text-base-content/40">-</span>{{ /if }}</div>
      </div>
      {{ if occupant.occupantData.lastLoginIp }}
        <div>
          <div class="text-xs text-base-content/50">IP do último acesso</div>
          <div class="font-mono text-xs">{{ occupant.occupantData.lastLoginIp }}</div>
        </div>
      {{ /if }}
      {{ if occupant.occupantData.lastLoginUserAgent }}
        <div class="md:col-span-2">
          <div class="text-xs text-base-content/50">Browser</div>
          <div class="text-xs text-base-content/70 truncate" title="{{ occupant.occupantData.lastLoginUserAgent }}">{{ occupant.occupantData.lastLoginUserAgent }}</div>
        </div>
      {{ /if }}
    </div>
  </div>
{{ else if occupant.occupantData.userId }}
  <div class="bg-base-200/40 rounded-xl border border-base-200 p-4 mb-6 text-xs text-base-content/60">
    Este ocupante já tem conta no portal mas ainda não fez login pela primeira vez.
  </div>
{{ /if }}

<div class="bg-base-100 rounded-xl border border-base-200 shadow-sm p-6 mb-6">
  <h2 class="text-sm font-semibold mb-4">Dados do ocupante</h2>
  <form method="post" action="/admin/c/{{ currentCondominiumId }}/occupants/{{ occupant.occupantId }}/update" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="form-control">
      <label class="label py-1" for="name"><span class="label-text text-xs">Nome *</span></label>
      <input type="text" id="name" name="name" required class="input input-sm input-bordered" value="{{ occupant.occupantData.name }}">
    </div>
    <div class="form-control">
      <label class="label py-1" for="email"><span class="label-text text-xs">Email</span></label>
      <input type="email" id="email" name="email" class="input input-sm input-bordered" value="{{ occupant.occupantData.email ?? '' }}">
    </div>
    <div class="form-control">
      <label class="label py-1" for="phone"><span class="label-text text-xs">Telemóvel</span></label>
      <input type="tel" id="phone" name="phone" class="input input-sm input-bordered" value="{{ occupant.occupantData.phone ?? '' }}">
    </div>
    <div class="form-control">
      <label class="label py-1" for="nif"><span class="label-text text-xs">NIF</span></label>
      <input type="text" id="nif" name="nif" class="input input-sm input-bordered" value="{{ occupant.occupantData.nif ?? '' }}">
    </div>
    <div class="form-control">
      <label class="label py-1" for="personType"><span class="label-text text-xs">Natureza jurídica</span></label>
      <select id="personType" name="personType" class="select select-sm select-bordered">
        <option value="singular" {{ if occupant.occupantData.personType !== "collective" }}selected{{ /if }}>Pessoa singular</option>
        <option value="collective" {{ if occupant.occupantData.personType === "collective" }}selected{{ /if }}>Pessoa coletiva (empresa)</option>
      </select>
      <p class="text-[11px] text-base-content/50 mt-1">Define a redação da procuração da convocatória (NIF / NIPC).</p>
    </div>
    {{# Hidden "off" antes da checkbox: browser não envia unchecked; o controller
       usa o último valor para distinguir on/off. #}}
    <div class="form-control md:col-span-2 pt-1">
      <label class="label cursor-pointer justify-start gap-3 py-1">
        <input type="hidden" name="receiveReceiptEmails" value="off">
        <input type="checkbox" name="receiveReceiptEmails" value="on" class="checkbox checkbox-primary checkbox-sm"
               {{ if occupant.occupantData.receiveReceiptEmails }}checked{{ /if }}>
        <span class="label-text text-xs font-medium">Receber recibos por email</span>
      </label>
      <p class="text-[11px] text-base-content/50 ml-8">Só se aplica a proprietários (apenas eles recebem recibos).</p>
    </div>
    <div class="md:col-span-2">
      <button type="submit" class="btn btn-sm btn-primary">Guardar alterações</button>
    </div>
  </form>
</div>

<div class="bg-base-100 rounded-xl border border-base-200 overflow-hidden shadow-sm mb-6" data-table-search-scope>
  <div class="flex justify-between items-center p-4 border-b border-base-200 flex-wrap gap-3">
    <div class="text-sm font-semibold">Frações associadas <span class="text-base-content/50 font-normal">· {{ occupant.units.length }}</span></div>
    <div class="flex items-center gap-2">
      <input type="search" data-table-search placeholder="Pesquisar…" class="input input-sm input-bordered">
      {{ if availableUnits.length > 0 }}
        <button type="button" class="btn btn-sm btn-primary"
                onclick="document.getElementById('modal_assoc_unit').showModal()">
          + Associar fração
        </button>
      {{ /if }}
    </div>
  </div>
  <div class="table-scroll">
  <table class="table table-sm">
    <thead>
      <tr class="text-base-content/40 text-[10px] uppercase tracking-widest">
        <th class="pl-4">Fração</th>
        <th>Relação</th>
        <th class="text-right">Permilagem</th>
        <th>Bloco</th>
        <th>Piso</th>
        <th>Porta</th>
        <th>Desde</th>
        <th>Até</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{ if occupant.units.length === 0 }}
        <tr><td colspan="9" class="p-8 text-center text-base-content/50">Este ocupante não tem frações associadas.</td></tr>
      {{ else }}
        {{ for entry of occupant.units }}
          <tr class="hover:bg-base-200/30 border-t border-base-100 text-sm">
            <td class="pl-4" data-search>
              <a href="/admin/c/{{ currentCondominiumId }}/units/{{ entry.unit.id }}" class="link link-hover">
                <span class="font-bold">{{ entry.unit.designation }}</span>{{ if entry.unit.identifier }}<span class="text-base-content/50 font-normal"> - {{ entry.unit.identifier }}</span>{{ /if }}
              </a>
            </td>
            <td>
              {{ if entry.relationshipType === "owner" }}
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-success/10 text-success border border-success/20">Proprietário</span>
              {{ else if entry.relationshipType === "tenant" }}
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-amber-100 border border-amber-200" style="color:#854D0E">Inquilino</span>
              {{ else }}
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-info/10 text-info border border-info/20">Residente</span>
              {{ /if }}
            </td>
            <td class="text-right tabular-nums font-semibold">{{ entry.unit.permillage |> formatPermillage }}‰</td>
            <td data-search>{{ entry.unit.block ?? "-" }}</td>
            <td data-search>{{ entry.unit.floor ?? "-" }}</td>
            <td data-search>{{ entry.unit.door ?? "-" }}</td>
            <td class="text-base-content/70 tabular-nums whitespace-nowrap">{{ entry.startDate |> formatDate }}</td>
            <td class="text-base-content/70 tabular-nums whitespace-nowrap">{{ if entry.endDate }}{{ entry.endDate |> formatDate }}{{ else }}<span class="text-base-content/30">-</span>{{ /if }}</td>
            <td class="pr-4 text-right whitespace-nowrap">
              {{# Modal único por linha (pelo unitOccupantId) edita a relação + datas. #}}
              <button type="button" class="link link-primary text-xs"
                      onclick="document.getElementById('modal_uo_{{ entry.unitOccupantId }}').showModal()">editar</button>
              <form method="post" action="/admin/c/{{ currentCondominiumId }}/occupants/{{ occupant.occupantId }}/units/{{ entry.unit.id }}/remove" class="inline ml-1"
                data-confirm-title="Remover associação"
                data-confirm-body="O ocupante deixa de estar associado a esta fração. O histórico fica preservado."
                data-confirm-ok="Remover"
                data-confirm-danger="true">
                <button type="submit" class="link link-error text-xs">×</button>
              </form>
            </td>
          </tr>
        {{ /for }}
      {{ /if }}
    </tbody>
  </table>
  </div>
</div>

{{# Associações já terminadas. Ficam à vista e editáveis: marcar a data de fim
   não pode equivaler a apagar o registo. #}}
{{ if occupant.pastUnits.length > 0 }}
  {{ layout "partials/table_card.vto" {
    title: "Associações anteriores",
    count: occupant.pastUnits.length,
    wrapperClass: "mb-6"
  } }}
    <table class="table table-sm">
      <thead>
        <tr class="text-base-content/40 text-[10px] uppercase tracking-widest">
          <th class="pl-4">Fração</th>
          <th>Relação</th>
          <th>Desde</th>
          <th>Até</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ for entry of occupant.pastUnits }}
          <tr class="hover:bg-base-200/30 border-t border-base-100 text-sm">
            <td class="pl-4">
              <a href="/admin/c/{{ currentCondominiumId }}/units/{{ entry.unit.id }}" class="link link-hover">
                <span class="font-bold">{{ entry.unit.designation }}</span>{{ if entry.unit.identifier }}<span class="text-base-content/50 font-normal"> - {{ entry.unit.identifier }}</span>{{ /if }}
              </a>
            </td>
            <td>
              {{ if entry.relationshipType === "owner" }}
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-success/10 text-success border border-success/20">Proprietário</span>
              {{ else if entry.relationshipType === "tenant" }}
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-amber-100 border border-amber-200" style="color:#854D0E">Inquilino</span>
              {{ else }}
                <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded bg-info/10 text-info border border-info/20">Residente</span>
              {{ /if }}
            </td>
            <td class="text-base-content/70 tabular-nums whitespace-nowrap">{{ entry.startDate |> formatDate }}</td>
            <td class="text-base-content/70 tabular-nums whitespace-nowrap">{{ entry.endDate |> formatDate }}</td>
            <td class="pr-4 text-right whitespace-nowrap">
              <button type="button" class="link link-primary text-xs"
                      onclick="document.getElementById('modal_uo_{{ entry.unitOccupantId }}').showModal()">editar</button>
            </td>
          </tr>
        {{ /for }}
      </tbody>
    </table>
  {{ /layout }}
{{ /if }}

{{# ═════════ MODAIS: Editar associação por linha ═════════ #}}
{{# 1 modal por unit_occupant (ativas e terminadas). POST ->
   /occupants/:id/units/:unitId/uo/:uoId/update. #}}
{{ for entry of occupant.units.concat(occupant.pastUnits) }}
  <dialog id="modal_uo_{{ entry.unitOccupantId }}" class="modal">
    <div class="modal-box max-w-md">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-lg mb-1">Editar associação</h3>
      <p class="text-xs text-base-content/60 mb-4">
        Fração <strong>{{ entry.unit.designation }}{{ if entry.unit.identifier }} - {{ entry.unit.identifier }}{{ /if }}</strong>
      </p>
      <form method="post"
            action="/admin/c/{{ currentCondominiumId }}/occupants/{{ occupant.occupantId }}/units/{{ entry.unit.id }}/uo/{{ entry.unitOccupantId }}/update"
            class="space-y-3">
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs font-medium">Relação</span></label>
          <select name="relationshipType" class="select select-sm select-bordered">
            <option value="owner" {{ if entry.relationshipType === "owner" }}selected{{ /if }}>Proprietário</option>
            <option value="tenant" {{ if entry.relationshipType === "tenant" }}selected{{ /if }}>Inquilino</option>
            <option value="resident" {{ if entry.relationshipType === "resident" }}selected{{ /if }}>Residente</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="form-control">
            <label class="label py-1" for="uo_start_{{ entry.unitOccupantId }}"><span class="label-text text-xs font-medium">Desde</span></label>
            <input type="date" id="uo_start_{{ entry.unitOccupantId }}" name="startDate" required
                   value="{{ entry.startDate ?? '' }}" class="input input-sm input-bordered">
          </div>
          <div class="form-control">
            <label class="label py-1" for="uo_end_{{ entry.unitOccupantId }}"><span class="label-text text-xs font-medium">Até <span class="text-base-content/40 font-normal">(opcional)</span></span></label>
            <input type="date" id="uo_end_{{ entry.unitOccupantId }}" name="endDate"
                   value="{{ entry.endDate ?? '' }}" class="input input-sm input-bordered">
          </div>
        </div>
        <p class="text-[11px] text-base-content/50">
          Sem data "Até", a associação é considerada ativa.
        </p>
        <div class="flex justify-end gap-2 pt-3 border-t border-base-200">
          <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('modal_uo_{{ entry.unitOccupantId }}').close()">Cancelar</button>
          <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
{{ /for }}

{{# Audit de emails enviados a este ocupante (audit.email_log por occupant_id). #}}
{{ include "partials/email_log_table.vto" { emails: occupantEmails } }}

{{# Zona perigosa - pattern canónico (ADR 0025). #}}
{{ include "partials/danger_zone.vto" {
  entityName: "ocupante",
  entityLabel: occupant.occupantName,
  actionUrl: "/admin/c/" + currentCondominiumId + "/occupants/" + occupant.occupantId + "/delete",
  confirmBody: occupant.units.length > 0
    ? ("Apaga " + occupant.occupantName + " e as " + String(occupant.units.length) + " associações a frações.")
    : ("Apaga " + occupant.occupantName + "."),
  currentUser,
} }}

{{# ═════════ MODAL: Associar fração ═════════ #}}
{{# Só quando há frações disponíveis. Mutação simples = `<dialog>` modal (ADR 0019). #}}
{{ if availableUnits.length > 0 }}
  {{# `overflow-visible` no modal-box: evita cortar o dropdown do combobox. #}}
  <dialog id="modal_assoc_unit" class="modal">
    <div class="modal-box max-w-md overflow-visible">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-lg mb-1">Associar fração</h3>
      <p class="text-xs text-base-content/60 mb-4">
        Liga {{ occupant.occupantName }} a uma fração com o tipo de relação adequado.
      </p>
      <form method="post"
            action="/admin/c/{{ currentCondominiumId }}/occupants/{{ occupant.occupantId }}/units"
            class="space-y-3">
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Fração *</span></label>
          {{# Combobox data-combobox (admin.vto). Haystack em lowercase para o filtro. #}}
          <div class="relative" data-combobox>
            <input type="text" data-combobox-search autocomplete="off"
                   placeholder="Pesquisar fração…"
                   class="input input-sm input-bordered" required>
            <input type="hidden" name="unitId" data-combobox-value value="" required>
            <ul data-combobox-list class="hidden absolute top-full left-0 right-0 z-30 mt-1 max-h-60 overflow-y-auto bg-base-100 border border-base-200 rounded-lg shadow-lg py-1">
              {{ for u of availableUnits }}
                <li data-combobox-option
                    data-id="{{ u.id }}"
                    data-label="{{ u.designation }}{{ if u.identifier }} - {{ u.identifier }}{{ /if }}"
                    data-haystack="{{ ((u.designation ?? '') + ' ' + (u.identifier ?? '')).toLowerCase() }}"
                    class="px-3 py-1.5 text-sm hover:bg-base-200 cursor-pointer">
                  <span class="font-medium">{{ u.designation }}</span>{{ if u.identifier }}<span class="text-base-content/50"> - {{ u.identifier }}</span>{{ /if }}
                </li>
              {{ /for }}
              <li data-combobox-empty class="hidden px-3 py-2 text-sm text-base-content/50 italic">Sem resultados.</li>
            </ul>
          </div>
        </div>
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Relação</span></label>
          <select name="relationshipType" class="select select-sm select-bordered">
            <option value="owner">Proprietário</option>
            <option value="tenant">Inquilino</option>
            <option value="resident">Residente</option>
          </select>
        </div>
        <div class="flex justify-end gap-2 pt-3 border-t border-base-200">
          <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('modal_assoc_unit').close()">Cancelar</button>
          <button type="submit" class="btn btn-sm btn-primary">Associar</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
{{ /if }}

{{ /layout }}
