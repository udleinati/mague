{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

{{# `totalPm` + `remaining` vêm do controller (necessários para o modal +
   Nova fração). `active` é calculado aqui (só usado no KPI). #}}
{{ set active = units.filter((u) => u.isActive).length }}

{{ layout "partials/page_header.vto" { title: "Frações" } }}
  <button type="button" onclick="document.getElementById('import_modal').showModal()" class="btn btn-sm btn-outline">Importar XLSX</button>
  <button type="button" class="btn btn-sm btn-primary" onclick="document.getElementById('modal_unit').showModal()">
    + Nova fração
  </button>
{{ /layout }}

<dialog id="import_modal" class="modal">
  <div class="modal-box max-w-md">
    <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
    <h3 class="font-bold text-lg mb-1">Importar frações + ocupantes</h3>
    <p class="text-sm text-base-content/60 mb-4">Descarrega o template, preenche e faz upload. Cada linha é uma fração + 1 ocupante; repete a linha para múltiplos ocupantes.</p>
    <a href="/admin/c/{{ currentCondominiumId }}/units/import/template.xlsx" class="btn btn-sm btn-ghost w-full mb-3">
      ⬇ Descarregar template (.xlsx)
    </a>
    {{# Import XLSX via dropzone canónica (partials/file_dropzone.vto). #}}
    <form method="post" action="/admin/c/{{ currentCondominiumId }}/units/import/preview" enctype="multipart/form-data" class="space-y-3">
      {{ include "partials/file_dropzone.vto" {
        name: "file",
        multiple: false,
        accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        helpText: "Ficheiro Excel (.xlsx)",
      } }}
      <button type="submit" class="btn btn-sm btn-primary w-full" data-upload-submit disabled>Pré-visualizar</button>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
  {{ if units.length === 0 }}
  <div class="bg-base-100 rounded-xl border border-base-200 shadow-sm p-12 text-center">
    <div class="text-5xl mb-3 text-base-content/30">🏢</div>
    <h2 class="text-xl font-bold mb-1">Ainda não tens frações</h2>
    <p class="text-sm text-base-content/60 max-w-md mx-auto mb-6">As frações são a base do condomínio - cada apartamento, garagem ou arrumos com a sua permilagem. Cria manualmente, ou importa uma lista em XLSX.</p>
    <div class="flex items-center justify-center gap-2 flex-wrap">
      <button type="button" class="btn btn-sm btn-primary" onclick="document.getElementById('modal_unit').showModal()">+ Nova fração</button>
      <button type="button" onclick="document.getElementById('import_modal').showModal()" class="btn btn-sm btn-outline">Importar XLSX</button>
      <a href="/admin/c/{{ currentCondominiumId }}/units/import/template.xlsx" class="btn btn-sm btn-ghost">⬇ Template</a>
    </div>
    <p class="text-xs text-base-content/50 mt-6">A soma das permilagens deve dar 1000. Podes adicionar frações por etapas.</p>
  </div>
{{ else }}
  {{# Status da permilagem total - 1000‰ é o todo do edifício (Art. 1418.º CC).
     Soma deve bater exatamente; desvios indicam erro de cadastro. Banner
     destacado quando há discrepância; chip discreto quando está OK. #}}
  {{ if totalPm < 1000 }}
    <div class="mb-6 rounded-xl border-2 border-warning bg-warning/10 px-4 py-3 flex items-start gap-3">
      <svg class="w-5 h-5 text-warning shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
      </svg>
      <div class="text-sm">
        <div class="font-semibold text-warning">Permilagem incompleta</div>
        <div class="text-xs text-base-content/70 mt-0.5">
          Total atual <strong class="tabular-nums">{{ totalPm |> formatPermillage }}‰</strong>.
          Faltam <strong class="tabular-nums">{{ remaining |> formatPermillage }}‰</strong> para chegar a 1000‰.
        </div>
      </div>
    </div>
  {{ else if totalPm > 1000 }}
    <div class="mb-6 rounded-xl border-2 border-error bg-error/10 px-4 py-3 flex items-start gap-3">
      <svg class="w-5 h-5 text-error shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
      </svg>
      <div class="text-sm">
        <div class="font-semibold text-error">Permilagem excedida</div>
        <div class="text-xs text-base-content/70 mt-0.5">
          Total atual <strong class="tabular-nums">{{ totalPm |> formatPermillage }}‰</strong>.
          Excede em <strong class="tabular-nums">{{ (totalPm - 1000) |> formatPermillage }}‰</strong>.
        </div>
      </div>
    </div>
  {{ else }}
    <div class="mb-6 rounded-lg border border-success/30 bg-success/5 px-3 py-1.5 inline-flex items-center gap-2 text-xs">
      <svg class="w-3.5 h-3.5 text-success" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span class="text-success font-medium">Permilagem completa - 1000‰</span>
    </div>
  {{ /if }}

  {{ set _totalPmStr = totalPm |> formatPermillage }}
  {{ set _fracoesCaption = String(active) + " ativas · " + _totalPmStr + "‰ total" }}
  {{ set _emAtrasoValue = stats.totalOverdueCents |> formatMoney }}
  {{ set _futurasValue = stats.totalFutureDebtCents |> formatMoney }}
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
    {{ include "partials/kpi_card.vto" {
      tone: "primary", label: "Frações", value: String(stats.total), caption: _fracoesCaption
    } }}
    {{ include "partials/kpi_card.vto" {
      tone: "success", label: "Ocupantes", value: String(stats.occupantsTotal),
      caption: (stats.occupantsTotal / stats.total).toFixed(1) + " por fração"
    } }}
    {{ include "partials/kpi_card.vto" {
      tone: "error", label: "Em atraso", value: _emAtrasoValue,
      caption: String(stats.unitsOverdue) + "/" + String(stats.total) + " frações com pendências vencidas",
      highlightValue: true
    } }}
    {{ include "partials/kpi_card.vto" {
      tone: "warning", label: "Futuras", value: _futurasValue, caption: "quotas lançadas por vencer"
    } }}
  </div>

  <div class="bg-base-100 rounded-xl border border-base-200 overflow-hidden shadow-sm" data-table-search-scope>
    <div class="flex justify-between items-center p-4 border-b border-base-200">
      <div class="text-sm font-semibold">Lista de frações <span class="text-base-content/50 font-normal">· {{ units.length }}</span></div>
      <div class="flex items-center gap-2">
        <input type="search" data-table-search placeholder="Pesquisar…" class="input input-sm input-bordered">
      </div>
    </div>
    <div class="table-scroll">
    <table class="table table-sm">
      <thead>
        <tr class="text-base-content/40 text-[10px] uppercase tracking-widest">
          <th class="pl-4">Fração</th>
          <th>Tipo</th>
          <th class="text-right">Permilagem</th>
          <th>Bloco / Piso / Porta</th>
          <th>Ocupantes</th>
          <th class="text-center">Nota</th>
          <th class="text-right">Em atraso</th>
          <th class="text-right">Futuras</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ for u of units }}
        {{# Ocupantes ativos = sem endDate. #}}
        {{ set _activeOccs = (u.occupants ?? []).filter((o) => !o.endDate) }}
        {{ set _occNames = _activeOccs.map((o) => o.occupant.name).join(", ") }}
        <tr class="hover:bg-base-200/30 border-t border-base-100 text-sm">
          <td class="pl-4 whitespace-nowrap" data-search>
            <span class="font-bold">{{ u.designation }}</span>{{ if u.identifier }}<span class="text-base-content/50 font-normal"> - {{ u.identifier }}</span>{{ /if }}
            {{# Plano de pagamento ativo (ADR 0039). #}}
            {{ if u.hasActivePlan }}
              <span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-info/10 text-info align-middle"
                    title="Fração em plano de pagamento">Em plano</span>
            {{ /if }}
          </td>
          <td class="text-base-content/70" data-search>{{ u.unitType }}</td>
          <td class="text-right tabular-nums font-semibold">{{ u.permillage |> formatPermillage }}‰</td>
          <td class="text-xs text-base-content/60">
            {{ if u.block || u.floor || u.door }}
              {{ if u.block }}Bl. {{ u.block }}{{ /if }}{{ if u.floor }} · Piso {{ u.floor }}{{ /if }}{{ if u.door }} · {{ u.door }}{{ /if }}
            {{ else }}-
            {{ /if }}
          </td>
          <td class="text-xs text-base-content/70 max-w-[220px]" data-search>
            {{ if _activeOccs.length === 0 }}
              <span class="text-base-content/30">-</span>
            {{ else }}
              <div class="truncate" title="{{ _occNames }}">{{ _occNames }}</div>
            {{ /if }}
          </td>
          {{# Nota da fração (`description`): ícone compacto (tooltip + modal) para a
             coluna não empurrar os valores. O span escondido é o que a pesquisa lê. #}}
          <td class="text-center">
            {{ if u.description }}
              <button type="button"
                      class="tooltip tooltip-left tooltip-quick btn btn-ghost btn-xs btn-square text-primary"
                      data-tip="{{ u.description }}"
                      data-unit-note-title="{{ u.designation }}"
                      aria-label="Ver nota"
                      onclick="openUnitNote(this)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                </svg>
              </button>
              <span class="hidden" data-search data-unit-note-full>{{ u.description }}</span>
            {{ else }}
              <span class="text-base-content/30">-</span>
            {{ /if }}
          </td>
          <td class="text-right tabular-nums whitespace-nowrap">
            {{ if u.overdueDebtCents > 0 }}
              <span class="font-semibold text-error">{{ u.overdueDebtCents |> formatMoney }}</span>
            {{ else }}
              <span class="text-base-content/30">-</span>
            {{ /if }}
          </td>
          <td class="text-right tabular-nums whitespace-nowrap">
            {{ if u.futureDebtCents > 0 }}
              <span class="text-base-content/70">{{ u.futureDebtCents |> formatMoney }}</span>
            {{ else }}
              <span class="text-base-content/30">-</span>
            {{ /if }}
          </td>
          <td>
            {{ if u.isActive }}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-success">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
                Ativa
              </span>
            {{ else }}
              <span class="inline-flex items-center gap-1.5 text-xs text-base-content/50">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-300"></span>
                Inactiva
              </span>
            {{ /if }}
          </td>
          <td class="pr-4 text-right whitespace-nowrap">
            {{ include "partials/action_link.vto" {
              kind: "view",
              href: "/admin/c/" + currentCondominiumId + "/units/" + u.id,
            } }}
          </td>
        </tr>
      {{ /for }}
      </tbody>
    </table>
    </div>
  </div>

  <dialog id="unit_note_modal" class="modal">
    <div class="modal-box max-w-xl">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-lg mb-3 pr-8">Nota da fração <span id="unit_note_title"></span></h3>
      <div class="text-sm text-base-content/80 whitespace-pre-line leading-relaxed" id="unit_note_content"></div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <script>
    window.openUnitNote = function (btn) {
      document.getElementById("unit_note_title").textContent = btn.getAttribute("data-unit-note-title") || "";
      document.getElementById("unit_note_content").textContent =
        btn.closest("td").querySelector("[data-unit-note-full]").textContent;
      document.getElementById("unit_note_modal").showModal();
    };
  </script>
{{ /if }}

{{ include "pages/units/_form_modal.vto" { currentCondominiumId, totalPm, remaining } }}

{{ /layout }}
