<!doctype html>
<html lang="pt" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Recuperar password - Mague</title>
    <link href="/app.css" rel="stylesheet">
  </head>
  <body class="bg-base-200 flex items-center justify-center min-h-screen">
    <div class="card w-full max-w-md bg-base-100 shadow-lg">
      <div class="card-body">
        <h1 class="text-3xl font-black text-teal-600 mb-1 tracking-tighter">MAGUE</h1>
        <p class="text-base-content/70 mb-6 text-sm">
          Recebe um link para definir nova password.
        </p>

        {{ if flash }}
          <div class="mb-4">
            {{ include "partials/alert.vto" { type: flash.type, message: flash.message } }}
          </div>
        {{ /if }}

        <form method="post" action="/forgot-password" class="space-y-4">
          <div class="form-control">
            <label class="label" for="identifier"><span class="label-text">Email ou NIF</span></label>
            <input type="text" id="identifier" name="identifier" class="input input-bordered" required autofocus
                   placeholder="email@dominio.pt ou 123456789">
            <p class="text-xs text-base-content/50 mt-2">
              Recebes o link no email registado para a tua conta.
            </p>
          </div>
          <button type="submit" class="btn btn-primary w-full">Enviar link</button>
        </form>

        <div class="mt-4 text-center">
          <a href="/login" class="text-xs text-base-content/60 hover:text-primary">← Voltar ao login</a>
        </div>
      </div>
    </div>
  </body>
</html>
