{{ layout "layouts/admin.vto" { title, section, condominium, availableCondominiums, currentCondominiumId, currentUser } }}

{{ layout "partials/page_header.vto" { title: "Seguros" } }}
  {{# Badge de cool-down: frações em proteção anti-spam que o bulk reminder salta. #}}
  {{ if cooldownCount > 0 }}
    <span class="text-xs text-base-content/60" title="Frações que receberam um lembrete nos últimos {{ String(cooldownDays) }} dias - bulk reminder ignora-as">
      {{ String(cooldownCount) }} em cool-down
    </span>
  {{ /if }}
  {{# `remindableCount` vem do controller pelo predicado `needsReminder` - a mesma
     lista que o bulk alveja no API. #}}
  {{ if remindableCount > 0 }}
    <form method="post" action="{{ '/insurances/reminders' |> condoPath }}"
          data-confirm-title="Enviar lembrete a todos os pendentes?"
          data-confirm-body="Vão ser enviados emails para os occupants das frações sem seguro válido (vencido, a expirar em {{ String(noticeDays) }} dias ou nunca submetido). As frações renovadas sem comprovativo recebem, em vez disso, o pedido do documento. Frações com lembrete recente ({{ String(cooldownDays) }} dias) ou sem email registado são saltadas.">
      <button type="submit" class="btn btn-sm btn-primary">Lembrar todos os pendentes</button>
    </form>
  {{ /if }}
{{ /layout }}

{{# Empty-state global: condomínio sem frações (distinto de filtros sem resultados). #}}
{{ if totalUnits === 0 }}
  <div class="bg-base-100 rounded-xl border border-base-200 shadow-sm p-12 text-center">
    <div class="text-5xl mb-3 text-base-content/30">🛡️</div>
    <h2 class="text-xl font-bold mb-1">Sem frações ativas</h2>
    <p class="text-sm text-base-content/60 max-w-md mx-auto">Cria primeiro as frações do condomínio.</p>
  </div>
{{ else }}
  {{# Modal de pré-visualização do email (dialog + iframe sandbox). O HTML vem
     on-demand da rota /preview e é injetado via srcdoc. Fora das linhas (OOB);
     os botões "ver" (dentro do swap) chamam a função global. #}}
  <dialog id="insurance_preview_modal" class="modal">
    <div class="modal-box max-w-4xl">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-base pr-8">Pré-visualização do email</h3>
      <p class="text-xs text-base-content/60 mt-1">Mostra a nota gravada e o destinatário da fração.</p>
      <div class="mt-3 text-sm flex items-baseline gap-2">
        <span class="text-base-content/50 shrink-0">Assunto:</span>
        <strong id="insurance_preview_subject" class="break-words"></strong>
      </div>
      <div class="mt-4 border border-base-200 rounded-lg overflow-hidden bg-base-200/40">
        <iframe id="insurance_preview_iframe" sandbox class="w-full h-[75vh] bg-white" title="Pré-visualização do email"></iframe>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fechar</button></form>
  </dialog>

  <script>
    window.openInsurancePreview = async function (url) {
      const modal = document.getElementById("insurance_preview_modal");
      const iframe = document.getElementById("insurance_preview_iframe");
      const subject = document.getElementById("insurance_preview_subject");
      subject.textContent = "";
      iframe.srcdoc =
        '<!doctype html><meta charset="utf-8"><body style="font-family:system-ui,sans-serif;padding:2rem;color:#6b7280;">A gerar pré-visualização...</body>';
      modal.showModal();
      try {
        const resp = await fetch(url, { headers: { Accept: "application/json" } });
        const data = await resp.json();
        subject.textContent = data.subject || "-";
        iframe.srcdoc = data.html;
      } catch (_e) {
        iframe.srcdoc =
          '<!doctype html><meta charset="utf-8"><body style="font-family:system-ui,sans-serif;padding:2rem;color:#b91c1c;">Erro a gerar a pré-visualização.</body>';
      }
    };
  </script>

  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4 mb-6">
    {{ include "partials/kpi_card.vto" {
      tone: "success", label: "Ativos", value: String(summary.active),
      caption: "com cobertura válida", highlightValue: summary.active > 0
    } }}
    {{ include "partials/kpi_card.vto" {
      tone: "warning", label: "A expirar", value: String(summary.expiring_soon),
      caption: "≤ " + String(noticeDays) + " dias", highlightValue: summary.expiring_soon > 0
    } }}
    {{ include "partials/kpi_card.vto" {
      tone: "error", label: "Vencidos", value: String(summary.expired),
      caption: "passaram da validade", highlightValue: summary.expired > 0
    } }}
    {{ include "partials/kpi_card.vto" {
      tone: "info", label: "A aprovar", value: String(summary.awaiting_approval),
      caption: "submetidas, aguardam revisão", highlightValue: summary.awaiting_approval > 0
    } }}
    {{# Renovações que a administração criou sem ver o documento novo: contam como
       cobertura, mas sem comprovativo ninguém confirmou que existe. #}}
    {{ include "partials/kpi_card.vto" {
      tone: "warning", label: "Presumidas", value: String(presumedPendingCount),
      caption: "renovadas sem comprovativo", highlightValue: presumedPendingCount > 0
    } }}
  </div>

  {{ if summary.never_submitted > 0 || summary.awaiting_confirmation > 0 || summary.rejected_only > 0 }}
    <div class="flex flex-wrap gap-4 mb-4 text-xs text-base-content/60">
      {{ if summary.never_submitted > 0 }}
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/30"></span>
          <strong class="text-base-content/90">{{ String(summary.never_submitted) }}</strong> sem submissão
        </span>
      {{ /if }}
      {{ if summary.awaiting_confirmation > 0 }}
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/30"></span>
          <strong class="text-base-content/90">{{ String(summary.awaiting_confirmation) }}</strong> aguardam condómino
        </span>
      {{ /if }}
      {{ if summary.rejected_only > 0 }}
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/30"></span>
          <strong class="text-base-content/90">{{ String(summary.rejected_only) }}</strong> rejeitadas
        </span>
      {{ /if }}
    </div>
  {{ /if }}

  {{# Nota da administração - texto livre persistente no condomínio, mostrado no
     topo do email de lembrete de seguro (abaixo dos KPI). Espelha o
     billing-reminders. Fora das linhas (OOB) para os swaps não recarregarem o
     que está a ser editado. #}}
  <form class="card bg-base-100 shadow-sm border border-base-200 mb-6"
        method="post"
        action="{{ '/insurances/note' |> condoPath }}"
        hx-post="{{ '/insurances/note' |> condoPath }}"
        hx-swap="none">
    <div class="px-6 pt-5 pb-4">
      <label class="label py-1" for="insurance-note">
        <span class="label-text font-semibold">Nota da administração</span>
      </label>
      <textarea id="insurance-note" name="note" rows="4" maxlength="2000"
                placeholder="Ex: A apólice deve cobrir o capital deliberado em assembleia de 12/05/2026. Submeta o PDF até 30/06/2026."
                class="textarea textarea-bordered w-full leading-snug">{{ condominium?.insuranceReminderNote ?? '' }}</textarea>
      <div class="flex flex-wrap items-center justify-between gap-2 mt-2">
        <span class="text-xs text-base-content/50">
          Aparece no topo do email de lembrete de seguro, numa caixa destacada. As quebras de linha são respeitadas. Deixa vazio para não mostrar nada. Guarda a nota antes de usar "Ver".
        </span>
        <button type="submit" class="btn btn-sm btn-primary">Guardar nota</button>
      </div>
    </div>
  </form>

  {{# ─── Barra de filtros: Ano | Estado ──────────────────────────────────
     Sem HTMX (submit nativo). Ano = vigência da apólice (cobre todos os anos
     que atravessa); linhas sem apólice passam sempre. #}}
  {{ set _yearQs = filterYear === null ? "&year=" : ("&year=" + String(filterYear)) }}
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <form action="/admin/c/{{ currentCondominiumId }}/insurances" method="get"
          class="flex items-center gap-2">
      {{ if filterStatus }}<input type="hidden" name="status" value="{{ filterStatus }}">{{ /if }}
      <span class="text-xs uppercase tracking-wider font-bold text-base-content/60">Ano</span>
      <select name="year" class="select select-sm select-bordered"
              onchange="this.form.submit()">
        <option value="" {{ if filterYear === null }}selected{{ /if }}>Todos</option>
        {{ for y of availableYears }}
          <option value="{{ String(y) }}" {{ if filterYear === y }}selected{{ /if }}>{{ String(y) }}</option>
        {{ /for }}
      </select>
      {{# Fallback no-JS: botão visível só se o user desactivar JS. #}}
      <noscript><button type="submit" class="btn btn-sm">Aplicar</button></noscript>
    </form>

    <div class="divider divider-horizontal mx-1 h-8"></div>

    {{ set _baseUrl = "/admin/c/" + currentCondominiumId + "/insurances?" }}
    <div class="tabs tabs-boxed bg-base-200/50">
      <a href="{{ _baseUrl }}status={{ _yearQs }}"
         class="tab tab-sm {{ if !filterStatus }}tab-active{{ /if }}">Todos</a>
      <a href="{{ _baseUrl }}status=active{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'active' }}tab-active{{ /if }}">Ativos</a>
      <a href="{{ _baseUrl }}status=expiring_soon{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'expiring_soon' }}tab-active{{ /if }}">A expirar</a>
      <a href="{{ _baseUrl }}status=expired{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'expired' }}tab-active{{ /if }}">Vencidos</a>
      <a href="{{ _baseUrl }}status=awaiting_approval{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'awaiting_approval' }}tab-active{{ /if }}">A aprovar</a>
      <a href="{{ _baseUrl }}status=awaiting_confirmation{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'awaiting_confirmation' }}tab-active{{ /if }}">Aguarda condómino</a>
      <a href="{{ _baseUrl }}status=rejected_only{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'rejected_only' }}tab-active{{ /if }}">Rejeitados</a>
      <a href="{{ _baseUrl }}status=never_submitted{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === 'never_submitted' }}tab-active{{ /if }}">Sem submissão</a>
      {{# Atravessa os estados agregados: uma presumida está "Ativa". #}}
      <a href="{{ _baseUrl }}status={{ presumedPendingFilter }}{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === presumedPendingFilter }}tab-active{{ /if }}">Presumidas s/ comprovativo</a>
      {{# Idem: o documento entregue à administração pode estar em qualquer estado. #}}
      <a href="{{ _baseUrl }}status={{ adminDocumentedFilter }}{{ _yearQs }}"
         class="tab tab-sm {{ if filterStatus === adminDocumentedFilter }}tab-active{{ /if }}">Documento da administração</a>
    </div>
  </div>

  <div class="bg-base-100 rounded-xl border border-base-200 overflow-hidden shadow-sm" data-table-search-scope data-policy-scope>
    <div class="flex justify-between items-center p-4 border-b border-base-200 gap-3 flex-wrap">
      <div class="text-sm font-semibold">Lista de seguros <span class="text-base-content/50 font-normal">· {{ String(units.length) }}</span></div>
      <div class="flex items-center gap-2 flex-wrap">
        <input type="search" data-table-search placeholder="Pesquisar…" class="input input-sm input-bordered">
        {{ if units.length > 0 }}
          <button type="button" data-policy-toggle-all class="btn btn-sm btn-ghost gap-1" data-state="closed">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
            <span data-toggle-label>Expandir tudo</span>
          </button>
        {{ /if }}
      </div>
    </div>
    <div class="table-scroll">
    <table class="table table-sm">
      <thead>
        <tr class="text-base-content/40 text-[10px] uppercase tracking-widest">
          <th class="pl-4 w-8"></th>
          <th>Fração</th>
          <th>Ocupantes</th>
          <th>Estado</th>
          <th>Validade</th>
          <th>Último lembrete</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ if units.length === 0 }}
          <tr>
            <td colspan="7" class="p-8 text-center text-base-content/50">
              Sem resultados para os filtros aplicados.
            </td>
          </tr>
        {{ /if }}
        {{ for u of units }}
          {{# Linhas em `_rows.vto` - reusadas em modo oob nas ações HTMX (approve/reject/renew/delete). #}}
          {{ include "pages/insurance/_rows.vto" {u, currentCondominiumId, oob: false} }}
        {{ /for }}
      </tbody>
    </table>
    </div>
  </div>

  {{# Toggle das linhas de detalhe; guard por flag global contra duplicação no re-inject HTMX. #}}
  <script>
    if (!window.__mgInsurancePolicyInit) {
      window.__mgInsurancePolicyInit = true;
      (function () {
        function setRowState(scope, unitId, open) {
          var summary = scope.querySelector('[data-policy-summary][data-unit-id="' + unitId + '"]');
          var detail = scope.querySelector('[data-policy-detail][data-unit-id="' + unitId + '"]');
          if (!summary || !detail) return;
          var chevron = summary.querySelector('[data-policy-chevron]');
          if (chevron) chevron.style.transform = open ? 'rotate(90deg)' : '';
          detail.classList.toggle('hidden', !open);
          summary.dataset.state = open ? 'open' : 'closed';
        }
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          // 0. "Rever" da linha-resumo: só abre o detalhe da fração.
          var expand = t.closest('[data-policy-expand]');
          if (expand) {
            var scopeExpand = expand.closest('[data-policy-scope]') || document;
            setRowState(scopeExpand, expand.getAttribute('data-unit-id') || '', true);
            return;
          }
          // 1. Botão "Expandir / Recolher tudo"
          var toggleAll = t.closest('[data-policy-toggle-all]');
          if (toggleAll) {
            var scopeAll = toggleAll.closest('[data-policy-scope]') || document;
            var willOpen = toggleAll.dataset.state === 'closed';
            scopeAll.querySelectorAll('[data-policy-summary]').forEach(function (row) {
              setRowState(scopeAll, row.getAttribute('data-unit-id') || '', willOpen);
            });
            toggleAll.dataset.state = willOpen ? 'open' : 'closed';
            var label = toggleAll.querySelector('[data-toggle-label]');
            if (label) label.textContent = willOpen ? 'Recolher tudo' : 'Expandir tudo';
            return;
          }
          // 2. Click na summary row - ignora se foi num link/botão/form
          //    (preserva os controlos PDF/aprovar/rejeitar/lembrar/apagar).
          var summary = t.closest('[data-policy-summary]');
          if (!summary) return;
          if (t.closest('a, button, form, input')) return;
          var scope = summary.closest('[data-policy-scope]') || document;
          var open = summary.dataset.state !== 'open';
          setRowState(scope, summary.getAttribute('data-unit-id') || '', open);
        });

        // ── Edit modal (ADR 0019) ─────────────────────────────────────
        // Botão "editar" lê data-* e popula o form; submit HTMX, HX-Trigger
        // "policySaved" fecha o modal. Delegação no document p/ apanhar botões OOB.
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          var btn = t.closest('[data-edit-policy]');
          if (!btn) return;
          var modal = document.getElementById('modal_edit_policy');
          var form = document.getElementById('edit_policy_form');
          if (!modal || !form) return;
          e.stopPropagation();
          var pid = btn.getAttribute('data-policy-id') || '';
          form.action = '/admin/c/{{ currentCondominiumId }}/insurances/' + pid + '/update';
          form.setAttribute('hx-post', form.action);
          form.querySelector('[name=validFrom]').value = btn.getAttribute('data-valid-from') || '';
          form.querySelector('[name=validTo]').value = btn.getAttribute('data-valid-to') || '';
          form.querySelector('[name=policyNumber]').value = btn.getAttribute('data-policy-number') || '';
          form.querySelector('[name=insurer]').value = btn.getAttribute('data-insurer') || '';
          var cents = btn.getAttribute('data-coverage-cents') || '';
          form.querySelector('[name=coverageAmountEuros]').value = cents
            ? String(parseInt(cents, 10) / 100).replace('.', ',') : '';
          if (window.htmx) window.htmx.process(form);
          modal.showModal();
        });
        // ── Modal do documento da administração (renovar / registar) ──
        // Um só modal para os dois: a diferença é a origem do URL, as datas
        // pré-preenchidas e o "renovar sem documento" (que não existe de raiz).
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          var renewBtn = t.closest('[data-renew-policy]');
          var createBtn = t.closest('[data-create-policy]');
          if (!renewBtn && !createBtn) return;
          var modal = document.getElementById('modal_policy_document');
          var form = document.getElementById('policy_document_form');
          var plain = document.getElementById('policy_renew_plain_form');
          if (!modal || !form || !plain) return;
          e.stopPropagation();

          var url = renewBtn
            ? (renewBtn.getAttribute('data-renew-url') || '')
            : (createBtn.getAttribute('data-create-url') || '');
          form.action = url;
          form.setAttribute('hx-post', url);

          form.querySelector('[name=validFrom]').value = renewBtn
            ? (renewBtn.getAttribute('data-valid-from') || '') : '';
          form.querySelector('[name=validTo]').value = renewBtn
            ? (renewBtn.getAttribute('data-valid-to') || '') : '';

          // Nº/seguradora/capital: editáveis só quando há documento de onde os
          // transcrever. De raiz ficam fora do form - saem do OCR.
          var details = form.querySelector('[data-renew-details]');
          var num = renewBtn ? (renewBtn.getAttribute('data-policy-number') || '') : '';
          var ins = renewBtn ? (renewBtn.getAttribute('data-insurer') || '') : '';
          var cents = renewBtn ? (renewBtn.getAttribute('data-coverage-cents') || '') : '';
          var euros = cents ? String(parseInt(cents, 10) / 100).replace('.', ',') : '';
          details.classList.toggle('hidden', !renewBtn);
          form.querySelector('[name=policyNumber]').value = num;
          form.querySelector('[name=insurer]').value = ins;
          form.querySelector('[name=coverageAmountEuros]').value = euros;
          form.querySelector('[name=policyNumber]').disabled = !renewBtn;
          form.querySelector('[name=insurer]').disabled = !renewBtn;
          form.querySelector('[name=coverageAmountEuros]').disabled = !renewBtn;

          var inherits = document.querySelector('[data-renew-inherits]');
          inherits.textContent = renewBtn
            ? ('Copia da atual: ' + (num || 'sem nº') + ' · ' + (ins || 'sem seguradora') +
               ' · ' + (euros ? euros + ' €' : 'sem capital') + '.')
            : '';

          // Limpa o ficheiro de uma abertura anterior; o `change` faz o JS
          // global redesenhar a dropzone e voltar a desativar o submit.
          var input = form.querySelector('[data-file-input]');
          if (input) {
            input.value = '';
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }

          // Sem documento só se renova: de raiz não há vigência de onde partir.
          plain.classList.toggle('hidden', !renewBtn);
          if (renewBtn) {
            plain.action = url;
            plain.setAttribute('hx-post', url);
          }

          document.querySelector('[data-doc-title]').textContent = renewBtn
            ? 'Renovar apólice' : 'Registar apólice';
          document.querySelector('[data-doc-help]').textContent = renewBtn
            ? 'Anexa o documento que a fração entregou à administração. A nova vigência fica a aguardar aprovação e a apólice atual continua ativa até lá.'
            : 'Fração ' + (createBtn.getAttribute('data-unit-designation') || '') +
              '. O documento é obrigatório: sem apólice que se possa renovar não há vigência de onde partir.';

          if (window.htmx) { window.htmx.process(form); window.htmx.process(plain); }
          modal.showModal();
        });

        // Fecha o modal aberto quando o server confirma o save.
        document.body.addEventListener('policySaved', function () {
          ['modal_edit_policy', 'modal_policy_document'].forEach(function (id) {
            var modal = document.getElementById(id);
            if (modal) modal.close();
          });
        });
      })();
    }
  </script>

  {{# ─── Modal: documento entregue à administração (renovar / registar) ──
     Serve o renew com anexo e a criação de raiz - o mesmo envelope multipart
     (ficheiro + vigência). O título, o URL e as datas são postos pelo JS acima.
     Ao contrário do portal, aqui usa-se `uploadAccept`: não há pré-visualização
     do ficheiro, logo o HEIC não tem de ser excluído. #}}
  <dialog id="modal_policy_document" class="modal">
    <div class="modal-box max-w-2xl">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-lg mb-1" data-doc-title>Renovar apólice</h3>
      <p class="text-xs text-base-content/60 mb-4" data-doc-help></p>

      <form id="policy_document_form" method="post" action=""
            hx-post="" hx-swap="none"
            hx-encoding="multipart/form-data" enctype="multipart/form-data"
            class="space-y-4">
        {{ include "partials/file_dropzone.vto" {
          name: "file",
          multiple: false,
          required: false,
          accept: uploadAccept,
          helpText: "O documento que a fração entregou à administração. Máximo " + String(uploadMaxMb) + " MB."
        } }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label" for="pd_validFrom"><span class="label-text font-medium">Início vigência</span></label>
            <input type="date" id="pd_validFrom" name="validFrom" class="input input-bordered" required>
          </div>
          <div class="form-control">
            <label class="label" for="pd_validTo"><span class="label-text font-medium">Fim vigência</span></label>
            <input type="date" id="pd_validTo" name="validTo" class="input input-bordered" required>
          </div>
        </div>
        {{# Só na renovação: de raiz não há anterior de onde herdar e os dados
           saem do OCR. Campo apagado herda o da apólice anterior. #}}
        <div class="hidden space-y-4" data-renew-details>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-control">
              <label class="label" for="pd_policyNumber"><span class="label-text font-medium">Nº da apólice</span></label>
              <input type="text" id="pd_policyNumber" name="policyNumber" class="input input-bordered">
            </div>
            <div class="form-control">
              <label class="label" for="pd_insurer"><span class="label-text font-medium">Seguradora</span></label>
              <input type="text" id="pd_insurer" name="insurer" class="input input-bordered">
            </div>
          </div>
          <div class="form-control">
            <label class="label" for="pd_coverage"><span class="label-text font-medium">Capital segurado</span></label>
            <div class="join">
              <input type="text" id="pd_coverage" name="coverageAmountEuros" inputmode="decimal"
                     placeholder="0,00" class="input input-bordered join-item flex-1 tabular-nums">
              <span class="btn btn-disabled join-item">€</span>
            </div>
          </div>
        </div>
        <p class="text-xs text-base-content/50">
          Confere as datas contra o documento antes de guardar - são estas que ficam registadas, não o que o sistema sugeriu.
        </p>

        <div class="flex justify-end gap-2 pt-4 border-t border-base-200">
          <button type="button" class="btn btn-sm btn-ghost"
                  onclick="document.getElementById('modal_policy_document').close()">Cancelar</button>
          <button type="submit" class="btn btn-sm btn-primary" data-upload-submit disabled>Guardar</button>
        </div>
      </form>

      {{# Caminho de hoje (renovação presumida + pedido do comprovativo à fração).
         Form à parte para não arrastar o ficheiro nem as datas do form de cima. #}}
      <form id="policy_renew_plain_form" method="post" action=""
            hx-post="" hx-swap="none"
            class="mt-4 pt-3 border-t border-base-200 flex flex-wrap items-center justify-between gap-2">
        <div class="text-xs text-base-content/50">
          Ainda não tens o documento?
          {{# Sem papel não se transcreve nada: o que a presumida copia fica à
             vista, para o admin ver o que está a assumir. #}}
          <span class="block mt-0.5" data-renew-inherits></span>
        </div>
        <button type="submit" class="btn btn-sm btn-ghost">Renovar sem documento</button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  {{# ─── Modal: editar apólice (ADR 0019) ─────────────────────────────── #}}
  <dialog id="modal_edit_policy" class="modal">
    <div class="modal-box max-w-2xl">
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button></form>
      <h3 class="font-bold text-lg mb-1">Editar apólice</h3>
      <p class="text-xs text-base-content/60 mb-4">
        Edição só permitida em <strong>pending_review</strong> (ADR 0016). Para corrigir uma ativa, reabre primeiro.
      </p>

      <form id="edit_policy_form" method="post" action=""
            hx-post="" hx-swap="none" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label" for="ep_validFrom"><span class="label-text font-medium">Início vigência</span></label>
            <input type="date" id="ep_validFrom" name="validFrom" class="input input-bordered" required>
          </div>
          <div class="form-control">
            <label class="label" for="ep_validTo"><span class="label-text font-medium">Fim vigência</span></label>
            <input type="date" id="ep_validTo" name="validTo" class="input input-bordered" required>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label" for="ep_policyNumber"><span class="label-text font-medium">Nº apólice</span></label>
            <input type="text" id="ep_policyNumber" name="policyNumber" maxlength="60"
                   class="input input-bordered" placeholder="Ex: POL-12345">
          </div>
          <div class="form-control">
            <label class="label" for="ep_insurer"><span class="label-text font-medium">Seguradora</span></label>
            <input type="text" id="ep_insurer" name="insurer" maxlength="80"
                   class="input input-bordered" placeholder="Ex: Fidelidade">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label" for="ep_coverage">
              <span class="label-text font-medium">Capital segurado</span>
              <span class="label-text-alt text-base-content/50">vazio = não declarado</span>
            </label>
            <div class="join">
              <input type="text" id="ep_coverage" name="coverageAmountEuros"
                     inputmode="decimal" placeholder="0,00"
                     class="input input-bordered join-item flex-1 tabular-nums">
              <span class="btn btn-disabled join-item">€</span>
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-4 border-t border-base-200">
          <button type="button" class="btn btn-sm btn-ghost"
                  onclick="document.getElementById('modal_edit_policy').close()">Cancelar</button>
          <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

{{ /if }}

{{ /layout }}
