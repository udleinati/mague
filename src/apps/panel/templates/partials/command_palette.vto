{{# Command palette (Cmd/Ctrl-K). Navegação por nome - lista de destinos vem
    de `adminNav.palette` (fonte: nav.ts), serializada no atributo `data-items`
    (convenção panel: apóstrofes + autoescape do Vento). O JS reusa
    `window.normalizeSearch`. Aberto por qualquer `[data-command-open]`. #}}
{{ if adminNav }}
<dialog id="command_palette" class="modal modal-top" data-items='{{ JSON.stringify(adminNav.palette) }}'>
  {{# Desktop (md+): card centrado ancorado a 12vh (`mx-auto` + `rounded-2xl`) -
      input fixo, só a lista muda de altura (sem "salto" da centragem ao filtrar).
      Mobile: top-sheet à largura toda, encostado ao topo e só com cantos
      inferiores (o `modal-top` do daisyUI já força width:100% + topo reto). #}}
  <div class="modal-box max-w-xl mx-auto p-0 mt-0 md:mt-[12vh] overflow-hidden shadow-2xl rounded-b-2xl md:rounded-2xl ring-1 ring-base-300/50">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-base-200">
      <svg class="w-4 h-4 text-base-content/40 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
      <input id="command_palette_input" type="text" autocomplete="off" spellcheck="false"
             placeholder="Procurar página..."
             class="w-full bg-transparent text-sm focus:outline-none" aria-label="Procurar página">
      <kbd class="kbd kbd-sm hidden sm:inline-flex">Esc</kbd>
    </div>
    <ul id="command_palette_results" class="menu menu-sm flex-nowrap p-2 max-h-[60vh] overflow-y-auto block"></ul>
  </div>
  <form method="dialog" class="modal-backdrop bg-black/30 backdrop-blur-sm"><button>fechar</button></form>
</dialog>

<script>
  (function () {
    var dialog = document.getElementById("command_palette");
    if (!dialog) return;
    var input = document.getElementById("command_palette_input");
    var results = document.getElementById("command_palette_results");
    var norm = window.normalizeSearch || function (s) { return (s || "").toString().toLowerCase(); };

    var items = [];
    try { items = JSON.parse(dialog.getAttribute("data-items") || "[]"); } catch (_e) { items = []; }
    // Pré-computa o haystack normalizado de cada item (rótulo + caminho + sinónimos).
    items.forEach(function (it) {
      it._hay = norm(it.label + " " + (it.path || "") + " " + (it.terms || ""));
      it._label = norm(it.label);
    });

    var rows = [];        // âncoras <a> visíveis, em ordem de exibição
    var selected = 0;

    // Hint de atalho na afordância (⌘K no mac, Ctrl K no resto).
    var isMac = /mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent || "");
    document.querySelectorAll("[data-cmdk-hint]").forEach(function (el) {
      el.textContent = isMac ? "⌘K" : "Ctrl K";
    });

    function rank(q) {
      var out = [];
      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        var score;
        if (it._label.indexOf(q) === 0) score = 0;
        else if (it._label.indexOf(q) !== -1) score = 1;
        else if (it._hay.indexOf(q) !== -1) score = 2;
        else continue;
        out.push({ it: it, score: score });
      }
      out.sort(function (a, b) {
        if (a.score !== b.score) return a.score - b.score;
        return a.it.label.localeCompare(b.it.label, "pt");
      });
      return out.map(function (r) { return r.it; });
    }

    function makeRow(it) {
      var li = document.createElement("li");
      var a = document.createElement("a");
      a.className = "command-row flex items-center justify-between gap-3";
      a.setAttribute("data-href", it.href);
      a.setAttribute("role", "option");
      var left = document.createElement("span");
      left.className = "truncate";
      left.textContent = it.label;
      a.appendChild(left);
      if (it.path) {
        var right = document.createElement("span");
        right.className = "text-xs text-base-content/40 shrink-0 ml-auto pl-2";
        right.textContent = it.path;
        a.appendChild(right);
      }
      li.appendChild(a);
      results.appendChild(li);
      rows.push(a);
    }

    function groupHeader(label) {
      var li = document.createElement("li");
      li.className = "menu-title pt-2 pb-1";
      var s = document.createElement("span");
      s.className = "text-[10px] uppercase tracking-wider";
      s.textContent = label;
      li.appendChild(s);
      results.appendChild(li);
    }

    function render(qRaw) {
      results.innerHTML = "";
      rows = [];
      selected = 0;
      var q = norm((qRaw || "").trim());

      if (!q) {
        // Query vazia: lista completa, agrupada (mapa do site).
        var currentGroup = null;
        items.forEach(function (it) {
          if (it.group !== currentGroup) {
            currentGroup = it.group;
            groupHeader(currentGroup);
          }
          makeRow(it);
        });
      } else {
        var matches = rank(q);
        if (matches.length === 0) {
          var li = document.createElement("li");
          li.className = "px-3 py-6 text-center text-sm text-base-content/50";
          li.textContent = "Sem resultados para «" + qRaw.trim() + "»";
          results.appendChild(li);
        } else {
          matches.forEach(makeRow);
        }
      }
      highlight();
    }

    function highlight() {
      rows.forEach(function (a, i) {
        a.classList.toggle("bg-base-200", i === selected);
        a.classList.toggle("font-medium", i === selected);
        if (i === selected) a.setAttribute("aria-selected", "true");
        else a.removeAttribute("aria-selected");
      });
      if (rows[selected]) rows[selected].scrollIntoView({ block: "nearest" });
    }

    function go(a) {
      if (!a) return;
      var href = a.getAttribute("data-href");
      if (!href) return;
      dialog.close();
      window.location.href = href;
    }

    function open() {
      render("");
      if (!dialog.open) dialog.showModal();
      input.value = "";
      // Foco após o showModal para o autofocus do dialog não competir.
      setTimeout(function () { input.focus(); }, 20);
    }

    input.addEventListener("input", function () { render(input.value); });

    input.addEventListener("keydown", function (e) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (rows.length) { selected = (selected + 1) % rows.length; highlight(); }
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (rows.length) { selected = (selected - 1 + rows.length) % rows.length; highlight(); }
      } else if (e.key === "Enter") {
        e.preventDefault();
        go(rows[selected]);
      }
    });

    // Click num resultado.
    results.addEventListener("click", function (e) {
      var a = e.target.closest(".command-row");
      if (a) { e.preventDefault(); go(a); }
    });

    // Abrir via afordância visível.
    document.querySelectorAll("[data-command-open]").forEach(function (btn) {
      btn.addEventListener("click", function (e) { e.preventDefault(); open(); });
    });

    // Atalho global Cmd/Ctrl-K.
    document.addEventListener("keydown", function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });
  })();
</script>
{{ /if }}
