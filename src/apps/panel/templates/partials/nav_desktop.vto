{{# Nav horizontal (desktop) gerado de `adminNav.entries` (fonte: nav.ts).
    Recebe `nav` = adminNav.entries. Taxonomia idêntica à hand-rolled anterior. #}}
{{ for e of nav }}
  {{ if e.kind === "link" }}
    <a href="{{ e.href }}"
       class="px-3 py-2 rounded-lg transition-colors flex items-center gap-1 {{ if e.active }}bg-primary/10 text-primary font-semibold{{ else }}hover:bg-base-200 text-base-content/70 hover:text-base-content{{ /if }}">
      {{ e.label }}
    </a>
  {{ else }}
    <div class="dropdown dropdown-hover">
      <label tabindex="0"
             class="px-3 py-2 rounded-lg transition-colors cursor-pointer flex items-center gap-1 {{ if e.active }}bg-primary/10 text-primary font-semibold{{ else }}hover:bg-base-200 text-base-content/70 hover:text-base-content{{ /if }}">
        {{ e.label }}
        {{ if e.hasBadge }}<span class="inline-block w-1.5 h-1.5 rounded-full bg-error" title="Itens a precisar de atenção"></span>{{ /if }}
        <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </label>
      <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box shadow-lg border border-base-200 w-60 p-1 mt-0 z-10">
        {{ for sg of e.subgroups }}
          {{ if sg.label }}
            <li class="menu-title pt-2 pb-1"><span class="text-[10px] uppercase tracking-wider">{{ sg.label }}</span></li>
          {{ /if }}
          {{ for it of sg.items }}
            <li>
              <a href="{{ it.href }}" class="flex justify-between items-center {{ if it.active }}active{{ /if }}">
                <span>{{ it.label }}</span>
                {{ if it.badgeCount > 0 }}<span class="badge badge-sm badge-error text-white border-error">{{ String(it.badgeCount) }}</span>{{ /if }}
              </a>
            </li>
          {{ /for }}
        {{ /for }}
      </ul>
    </div>
  {{ /if }}
{{ /for }}
