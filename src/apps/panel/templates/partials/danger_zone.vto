{{# "Zona perigosa" - bloco canónico para ações destrutivas irreversíveis.
   Três guards (ADR 0025): <details> colapsado, tag IRREVERSÍVEL, modal com
   typed-match (ADR 0013). Posicionar no fim do show.vto, antes do {{ /layout }}.

   Params:
     entityName       - lowercase singular ("fração", "patologia", "ocorrência").
     entityLabel      - identificador humano para o título do modal e mensagem
                        ("P008", "fração 1A", "T042").
     actionUrl        - URL POST do endpoint /:id/delete (absoluto ou via
                        `condoPath`).
     confirmBody      - uma frase curta descrevendo a consequência. Aparece
                        tanto na zona perigosa expandida como no modal (este
                        adiciona " Não é reversível." automaticamente).
     currentUser      - objeto com `.email` (e opcionalmente `.name`).
                        Mostrado como "executado por" dentro do modal.
                        Passado pelo layout - quando ausente, a atribuição
                        no modal não aparece (não falha).
     extraNote        - opcional, segundo parágrafo (e.g. casos especiais).
                        Evita usar - default é texto curto e único.
     actionVerb       - opcional, verbo da ação. Default "Eliminar". Usar
                        "Cancelar" para anulações irreversíveis (ex: charge).
     typedWord        - opcional, palavra do typed-match. Default "ELIMINAR".
                        Alinhar com o verbo ("CANCELAR" para cancelamentos).
     dangerIcon       - opcional, "trash" (default) ou "ban" (cancelar).
     dialogId         - opcional, id de um <dialog> próprio que o botão abre em vez
                        do modal global (ação que pede justificação, ex: cancelar
                        cobrança). O dialog trata do typed-match e do POST.
#}}

{{ set _verb = actionVerb ?? "Eliminar" }}
{{ set _typed = typedWord ?? "ELIMINAR" }}
{{ set _icon = dangerIcon ?? "trash" }}

<details class="group mt-12 border-t border-base-200 pt-6" data-danger-zone>
  <summary class="cursor-pointer inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.18em] font-semibold text-base-content/40 hover:text-error transition-colors select-none list-none">
    <svg class="w-3 h-3 transition-transform duration-150 group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
    Zona perigosa
  </summary>

  {{# Container neutro; vermelho só em pontos discretos (tag + ícone + CTA). #}}
  <div class="mt-3 max-w-2xl rounded-md border border-base-200 bg-base-100/40 px-5 py-4">
    <div class="flex items-center gap-1.5 mb-2">
      <svg class="w-3.5 h-3.5 text-error" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
      </svg>
      <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-error">Irreversível</span>
    </div>
    <h3 class="text-sm font-semibold text-base-content mb-1.5">{{ _verb }} {{ entityName }}</h3>
    <p class="text-xs text-base-content/70 leading-relaxed">{{ confirmBody }}</p>
    {{ if extraNote }}
      <p class="text-xs text-base-content/70 leading-relaxed mt-2">{{ extraNote }}</p>
    {{ /if }}

    {{# Atribuição "registado em nome de X" vive no modal de confirmação, não aqui
       - acende no último passo (typed-match), não enquanto o user lê. Ver ADR 0025. #}}
    <form method="post" action="{{ actionUrl }}" class="inline-block mt-4"
          {{ if !dialogId }}
          data-confirm-title="{{ _verb }} {{ entityLabel }}?"
          data-confirm-body="{{ confirmBody }} Não é reversível."
          data-confirm-ok="{{ _verb }} {{ entityName }}"
          data-confirm-danger="true"
          data-confirm-typed-match="{{ _typed }}"
          {{ /if }}>
      <button type="{{ dialogId ? "button" : "submit" }}" class="btn btn-sm btn-error gap-1.5"
              {{ if dialogId }}onclick="document.getElementById('{{ dialogId }}').showModal()"{{ /if }}>
        {{ if _icon === "ban" }}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
        {{ else }}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
          </svg>
        {{ /if }}
        {{ _verb }} {{ entityName }}
      </button>
    </form>
  </div>
</details>
