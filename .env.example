# Base de dados PostgreSQL
DATABASE_URL=postgres://mague:mague@localhost:5432/mague

# Aplicação
PORT=3000
ENVIRONMENT=development

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mague.pt

# Autenticação - ver ADR 0020
SESSION_SECRET=gerar-um-segredo-forte-com-pelo-menos-32-caracteres
# Cap absoluto do JWT/cookie. Cosmético - Valkey é fonte de verdade.
SESSION_EXPIRY_DAYS=7
# Idle TTL real da sessão Valkey (sliding). Sem uso, expira.
SESSION_IDLE_HOURS=3

# Panel (admin dashboard interno - server-rendered)
PANEL_API_URL=http://localhost:3000
PANEL_CONDOMINIUM_ID=
PANEL_PORT=3400

# URL pública do panel - usada pela API para construir links absolutos nos
# emails (recibos, convites, reset password). Em produção,
# https://painel.mague.pt. A API valida o header X-Panel-Base-URL enviado
# pelo panel contra este valor (allowlist anti-phishing).
PANEL_BASE_URL=http://localhost:3400
# Aliases extra (CSV) - útil para staging + prod na mesma API.
# PANEL_BASE_URL_EXTRA=https://staging.painel.mague.pt

# CORS - origins permitidos para chamadas cross-origin à API (csv).
# Em branco = sem CORS.
CORS_ORIGINS=

# Rate limit do login. Defaults aplicados pelo código quando não definidos:
#   per-(identifier,ip) = 5  | per-ip-global = 100 | window = 300s.
# Em dev/test convém valores generosos para a suite e2e não saturar.
LOGIN_RATE_LIMIT_MAX_PER_IDENTIFIER_IP=10000
LOGIN_RATE_LIMIT_MAX_PER_IP_GLOBAL=100000
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# S3 / Object storage (PDFs de recibos)
# Em dev usar RustFS via docker-compose (http://localhost:9000).
# Em prod apontar para AWS S3, Cloudflare R2, etc - mesmo SDK.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mague-receipts
S3_ACCESS_KEY=maguedev
S3_SECRET_KEY=maguedev123
S3_FORCE_PATH_STYLE=true
