{
  "compilerOptions": {
    "strict": true
  },
  "exclude": [
    ".claude",
    "coverage",
    "static",
    "test_sql",
    "deploy",
    "scripts",
    "src/apps/docs",
    "src/apps/panel/styles"
  ],
  "imports": {
    "hono": "jsr:@hono/hono@4.12.12",
    "hono/cookie": "jsr:@hono/hono@4.12.12/cookie",
    "hono/cors": "jsr:@hono/hono@4.12.12/cors",
    "hono/deno": "jsr:@hono/hono@4.12.12/deno",
    "@hono/hono/cookie": "jsr:@hono/hono@4.12.12/cookie",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@1.1.0",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@0.5.2",
    "@std/dotenv": "jsr:@std/dotenv@0.225.6",
    "@std/path": "jsr:@std/path@1.1.4",
    "@std/fs": "jsr:@std/fs@1.0.23",
    "@std/crypto": "jsr:@std/crypto@1.0.5",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing": "jsr:@std/testing@1.0.17",
    "@std/http": "jsr:@std/http@1.0.25",
    "vento": "jsr:@vento/vento@1.14.0",
    "postgres/": "https://deno.land/x/postgres@v0.17.2/",
    "postgresjs": "npm:postgres@3.4.5",
    "zod": "npm:zod@4.3.6",
    "nanoid": "npm:nanoid@5.0.9",
    "xlsx": "npm:xlsx@0.18.5",
    "djwt": "jsr:@zaubrik/djwt@3.0.2",
    "drizzle": "npm:drizzle-orm@0.45.2",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle/pg-core": "npm:drizzle-orm@0.45.2/pg-core",
    "drizzle/postgres-js": "npm:drizzle-orm@0.45.2/postgres-js",
    "$api/": "./src/apps/api/",
    "$panel/": "./src/apps/panel/",
    "$shared/": "./src/shared/",
    "$libs/": "./src/shared/",
    "$apps/": "./src/apps/",
    "$config/": "./src/config/"
  },
  "tasks": {
    "dev:api": "deno run --allow-net --allow-read --allow-env --allow-write --allow-sys --allow-run --watch=src/,static/ src/apps/api/main.ts",
    "dev:panel": "deno run --allow-net --allow-read --allow-env --allow-write --allow-sys --watch=src/,static/ src/apps/panel/main.ts",
    "start:api": "deno run --allow-net --allow-read --allow-env --allow-write --allow-sys --allow-run src/apps/api/main.ts",
    "start:panel": "deno run --allow-net --allow-read --allow-env --allow-write --allow-sys src/apps/panel/main.ts",
    "build:css": "cd src/apps/panel/styles && deno install && deno run -A npm:tailwindcss@3.4.17 -c tailwind.config.js -i input.css -o ../static/app.css --minify",
    "build:css:watch": "cd src/apps/panel/styles && deno install && deno run -A npm:tailwindcss@3.4.17 -c tailwind.config.js -i input.css -o ../static/app.css --watch",
    "migrate": "deno run --allow-net --allow-read --allow-env src/db/migrate.ts",
    "seed": "deno run --allow-net --allow-read --allow-env src/db/seed.ts",
    "seed:minimal": "deno run --allow-net --allow-read --allow-env src/db/seed.ts --dir=seeds_minimal",
    "seed:maximum": "deno run --allow-net --allow-read --allow-env src/db/seed.ts --dir=seeds_maximum",
    "test:up": "./test_sql/up.sh",
    "test:up:minimum": "./test_sql/up.sh seed:minimal",
    "test:up:maximum": "./test_sql/up.sh seed:maximum",
    "test:down": "./test_sql/down.sh",
    "test:sql": "./test_sql/run.sh",
    "test:api": "deno test --allow-net --allow-read --allow-env --allow-run test_api/*_test.ts",
    "test:api:up": "./test_api/up_isolated.sh",
    "test:api:isolated": "DATABASE_URL=postgres://mague:mague@localhost:5432/mague_test deno test --allow-net --allow-read --allow-env --allow-run test_api/*_test.ts",
    "test:api:restore": "docker compose up -d api",
    "test:api:rate-limit": "./test_api/_run_rate_limit.sh",
    "test:unit": "deno test --allow-read --allow-env src/",
    "test:unit:watch": "deno test --allow-read --allow-env --watch src/",
    "check": "deno check",
    "test:unit:cov": "rm -rf coverage && deno test --allow-read --allow-env --coverage=coverage src/ && deno coverage coverage --include='src/' --exclude='_test\\.ts$'",
    "test:unit:cov:html": "rm -rf coverage && deno test --allow-read --allow-env --coverage=coverage src/ && deno coverage coverage --include='src/' --exclude='_test\\.ts$' --html && echo 'Cobertura HTML em coverage/html/index.html'",
    "test:all": "deno task test:unit && deno task test:sql && deno task test:api",
    "docs:spec": "deno run --allow-net --allow-read --allow-env --allow-write src/apps/docs/src/main.ts",
    "docs:html": "deno run -A npm:@redocly/cli@1.25.11 build-docs -o static/docs/docs.html static/docs/swagger.json",
    "generate:docs": "deno task docs:spec && deno task docs:html"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "workspace": {
    "members": []
  }
}
